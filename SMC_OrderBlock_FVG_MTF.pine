string tf2         = input.timeframe("15", "", inline = "tf2", group = G_TF)
bool   useTF3      = input.bool(true, "HTF 3", inline = "tf3", group = G_TF)
string tf3         = input.timeframe("60", "", inline = "tf3", group = G_TF)
bool   useTF4      = input.bool(true, "HTF 4", inline = "tf4", group = G_TF)
string tf4         = input.timeframe("240", "", inline = "tf4", group = G_TF)
bool   useTF5      = input.bool(true, "HTF 5", inline = "tf5", group = G_TF)
