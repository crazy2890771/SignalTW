bool   dashFlip    = input.bool(true, "Show flip levels", group = G_DASH,
     tooltip = "ราคาที่ต้องปิดผ่าน เทรนด์ของ TF นั้นจึงจะกลับทิศ (Swing ล่าสุดที่ต้องเบรก)\n> 4168.5 = ปิดเหนือ 4168.5 จะกลับเป็น Bullish\n< 4140.2 = ปิดต่ำกว่า 4140.2 จะกลับเป็น Bearish\n– = ยังไม่มี Swing ใหม่ให้ใช้เป็นจุดกลับทิศ")
bool   alNear      = input.bool(true, "Price approaching a 1H / 4H / 1D zone", inline = "alnear", group = G_ALRT)
