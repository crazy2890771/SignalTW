bool   alTrend     = input.bool(true, "1H / 4H trend change", group = G_ALRT,
     tooltip = "แจ้งเตือนเมื่อเทรนด์ของ 1H หรือ 4H กลับทิศ (ช่องในตาราง Trend เปลี่ยนสี) แจ้งหลังแท่ง 1H / 4H ปิด")
bool   showDiv     = input.bool(true, "Show RSI divergence", group = G_DIV,
     tooltip = "Regular divergence บน TF ของกราฟ\nBull Div = ราคาทำ Low ต่ำลง แต่ RSI ทำ Low สูงขึ้น (แรงขายอ่อนลง)\nBear Div = ราคาทำ High สูงขึ้น แต่ RSI ทำ High ต่ำลง (แรงซื้ออ่อนลง)\nเส้นเชื่อม 2 จุดบนกราฟราคา แสดงย้อนหลังตาม History (days)")
int    rsiLen      = input.int(14, "RSI length", minval = 2, group = G_DIV)
int    divL        = input.int(5, "Pivot left", minval = 1, maxval = 20, inline = "dpv", group = G_DIV)
