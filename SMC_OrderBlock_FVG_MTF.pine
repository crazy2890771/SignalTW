// SignalTW - Order Block + Fair Value Gap + Market Structure (Multi-Timeframe)
//@version=6
indicator("SignalTW - Order Block & FVG [MTF]", "SignalTW OB/FVG", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

//==============================================================================
// INPUTS
//==============================================================================
const string G_TF   = "Timeframes (ดูได้ทุก TF)"
const string G_DISP = "Display (ลดความรก)"
const string G_OB   = "Order Block"
const string G_FVG  = "Fair Value Gap"
const string G_MS   = "Market Structure"
const string G_SIG  = "BUY / SELL Signals"
const string G_LTF  = "Entry model"
const string G_EXEC = "Execution & costs (backtest)"
const string G_TIME = "Session / news / volatility"
const string G_DASH = "Dashboard"

bool   showChartTF = input.bool(true, "Chart TF (TF ปัจจุบันของกราฟ)", group = G_TF)
bool   autoHTF     = input.bool(true, "Auto HTF (by chart TF)", group = G_TF,
     tooltip = "เลือก HTF ให้อัตโนมัติตาม TF ของกราฟ (ไม่ใช้ค่า HTF 1/2/3 ด้านล่าง)\n1m → 5m / 15m / 1H\n3m–5m → 15m / 1H / 4H\n15m → 1H / 4H / D\n1H → 4H / D / W")
bool   useTF1      = input.bool(true, "HTF 1", inline = "tf1", group = G_TF)
string tf1         = input.timeframe("15", "", inline = "tf1", group = G_TF)
bool   useTF2      = input.bool(true, "HTF 2", inline = "tf2", group = G_TF)
string tf2         = input.timeframe("60", "", inline = "tf2", group = G_TF)
bool   useTF3      = input.bool(true, "HTF 3", inline = "tf3", group = G_TF)
string tf3         = input.timeframe("240", "", inline = "tf3", group = G_TF,
     tooltip = "HTF ที่ต่ำกว่าหรือเท่ากับ TF ของกราฟจะไม่แสดง เช่น เปิดกราฟ 15m จะใช้ 1H และ 4H\nสำหรับ scalping แนะนำเปิดกราฟ 3m หรือ 5m แล้วใช้ 15m / 1H / 4H เป็นโซน")
int    swingLen    = input.int(5, "Swing length", minval = 2, maxval = 50, group = G_TF,
     tooltip = "จำนวนแท่งซ้าย/ขวาที่ใช้หา Swing High/Low สำหรับ Market Structure และ Order Block")

bool   nearestOnly = input.bool(true, "Show only nearest zones", inline = "near", group = G_DISP)
int    nearestN    = input.int(3, "", minval = 1, maxval = 20, inline = "near", group = G_DISP,
     tooltip = "แสดงเฉพาะโซนที่ใกล้ราคาปัจจุบันที่สุด N โซน ต่อฝั่ง (แยก OB / FVG) จากทุก TF รวมกัน")
bool   mergeTF     = input.bool(true, "Hide lower-TF zones inside higher-TF zones", group = G_DISP,
     tooltip = "ถ้าโซนของ TF เล็กซ้อนกับโซนประเภทเดียวกันของ TF ใหญ่ จะแสดงเฉพาะโซน TF ใหญ่ และเพิ่มชื่อ TF ในป้าย เช่น OB 4H+1H (Confluence)")
bool   hideMit     = input.bool(true, "Hide mitigated zones", group = G_DISP,
     tooltip = "ซ่อนโซนที่ราคาเข้าไปใช้แล้ว (ถ้าปิด จะหยุดยืดโซนและทำให้จางลงแทน)")
string lblSizeOpt  = input.string("Tiny", "Label size", options = ["Tiny", "Small", "Normal"], group = G_DISP)

bool   showOB      = input.bool(true, "Show Order Blocks", group = G_OB)
int    maxOB       = input.int(5, "Max OB stored per TF / side", minval = 1, maxval = 50, group = G_OB)
string obMitMode   = input.string("Close", "OB mitigation", options = ["Close", "Wick"], group = G_OB,
     tooltip = "Close = ปิดแท่งทะลุโซนถือว่าใช้แล้ว, Wick = ไส้เทียนแตะขอบไกลสุดของโซน")
float  obMaxAtr    = input.float(1.5, "Max OB height (x ATR)", minval = 0, step = 0.1, inline = "obh", group = G_OB,
     tooltip = "จำกัดความหนาของ OB เทียบกับ ATR(14) ของ TF นั้น (0 = ไม่จำกัด)\nTrim = ตัดให้เหลือเฉพาะส่วนที่ใกล้ราคา, Skip = ไม่แสดง OB ที่หนาเกิน")
string obSizeMode  = input.string("Trim", "", options = ["Trim", "Skip"], inline = "obh", group = G_OB)
color  bullOBCol   = input.color(color.new(#089981, 80), "Bullish OB", inline = "obc", group = G_OB)
color  bearOBCol   = input.color(color.new(#f23645, 80), "Bearish OB", inline = "obc", group = G_OB)

bool   showFVG     = input.bool(true, "Show Fair Value Gaps", group = G_FVG)
int    maxFVG      = input.int(5, "Max FVG stored per TF / side", minval = 1, maxval = 50, group = G_FVG)
float  fvgMinPct   = input.float(0.0, "Min gap size (%)", minval = 0, step = 0.01, group = G_FVG,
     tooltip = "กรอง FVG ที่เล็กกว่าเปอร์เซ็นต์นี้ของราคา (0 = แสดงทั้งหมด)")
color  bullFVGCol  = input.color(color.new(#2962ff, 80), "Bullish FVG", inline = "fvgc", group = G_FVG)
color  bearFVGCol  = input.color(color.new(#ff9800, 80), "Bearish FVG", inline = "fvgc", group = G_FVG)

string msMode      = input.string("None", "BOS / CHoCH (chart TF)", options = ["All", "CHoCH only", "None"], group = G_MS)
color  msBullCol   = input.color(#089981, "Bullish", inline = "msc", group = G_MS)
color  msBearCol   = input.color(#f23645, "Bearish", inline = "msc", group = G_MS)

bool   showSig     = input.bool(true, "Show BUY / SELL signals", group = G_SIG,
     tooltip = "BUY: ราคาย่อลงแตะโซน Bullish (OB/FVG) แล้วปิดแท่งเขียวกลับขึ้นเหนือโซน\nSELL: ราคาเด้งขึ้นแตะโซน Bearish แล้วปิดแท่งแดงกลับลงใต้โซน\nแต่ละโซนให้สัญญาณได้ครั้งเดียว")
string sigPreset   = input.string("Scalp", "Signal frequency", options = ["Scalp", "High", "Medium", "Low", "Custom"], group = G_SIG,
     tooltip = "Scalp = หลายสัญญาณต่อวัน สำหรับกราฟ 1m–5m (ทุกโซนรวมโซนของกราฟ, ตามเทรนด์ HTF หรือกลับตัวด้วย CHoCH, ไม่ใช้ Premium/Discount, รอ 15 นาที)\nLow = น้อยแต่คัดมาก (โซน HTF, ตามเทรนด์ HTF, Premium/Discount, รอ 120 นาที)\nMedium = สมดุล (โซน HTF + OB ของกราฟ, ตามเทรนด์ HTF หรือกลับตัวด้วย CHoCH ของ HTF ที่ต่ำกว่า, Premium/Discount, รอ 60 นาที)\nHigh = สัญญาณมาก (ทุกโซน, ไม่ใช้ Premium/Discount, รอ 30 นาที)\nCustom = ใช้ค่าด้านล่างทั้งหมด")
string sigFilter   = input.string("HTF trend or CHoCH", "Trend filter (Custom)", options = ["HTF trend or CHoCH", "HTF trend", "Chart trend", "Both", "None"], group = G_SIG,
     tooltip = "HTF trend or CHoCH = BUY เมื่อเทรนด์ HTF สูงสุดเป็นขาขึ้น หรือ HTF ที่ต่ำที่สุด (เช่น 1H) เกิด CHoCH กลับเป็นขาขึ้นแล้ว (SELL กลับกัน) ถ้าเปิด HTF ไว้ตัวเดียวจะใช้ CHoCH ของ TF กราฟ\nHTF trend = ตามเทรนด์ HTF ที่สูงที่สุดที่เปิดอยู่เท่านั้น\nChart trend = ใช้เทรนด์ TF กราฟ\nBoth = ต้องตรงกันทั้งคู่\nNone = ไม่กรอง")
string sigZones    = input.string("OB + FVG", "Signal zones", options = ["OB + FVG", "OB only", "FVG only"], inline = "sz", group = G_SIG)
string sigZoneTF   = input.string("HTF + chart OB", "", options = ["All TF", "HTF + chart OB", "HTF only"], inline = "sz", group = G_SIG,
     tooltip = "(Custom) HTF only = ใช้เฉพาะโซนของ HTF, HTF + chart OB = เพิ่ม OB ของ TF กราฟ, All TF = ทุกโซน\nถ้าไม่มี HTF ที่สูงกว่ากราฟจะใช้โซนของกราฟแทน")
bool   usePD       = input.bool(true, "Premium / Discount filter (Custom)", inline = "pd", group = G_SIG,
     tooltip = "BUY เฉพาะเมื่อราคาอยู่ครึ่งล่าง (Discount) ของกรอบราคา HTF, SELL เฉพาะครึ่งบน (Premium)\nกรอบราคา = High/Low สูงสุด-ต่ำสุดของ N แท่งล่าสุดบน TF ที่ใช้กรองเทรนด์")
int    pdLen       = input.int(50, "Bars", minval = 10, maxval = 500, inline = "pd", group = G_SIG)
float  sigDepart   = input.float(0.75, "Min move away before retest (x ATR, Custom)", minval = 0, step = 0.25, group = G_SIG,
     tooltip = "ราคาต้องวิ่งออกจากโซนอย่างน้อยเท่านี้ (เทียบ ATR) ก่อน แล้วค่อยย้อนกลับมาแตะ จึงนับเป็นสัญญาณ\nกันสัญญาณหลอกจากโซนที่เพิ่งเกิดหรือราคายังวนอยู่ในโซน")
int    sigCooldown = input.int(60, "Min minutes between signals (Custom)", minval = 0, step = 15, group = G_SIG,
     tooltip = "ระยะเวลาขั้นต่ำระหว่างสัญญาณ (นาที) ใช้เวลาจริงจึงได้ผลเท่ากันทุก TF")
bool   showSLTP    = input.bool(true, "Show SL / TP (last signal)", inline = "sltp", group = G_SIG)
float  rrRatio     = input.float(2.0, "R:R", minval = 0.5, step = 0.5, inline = "sltp", group = G_SIG,
     tooltip = "TP = Entry ± R:R × Risk (Risk = ระยะจาก Entry จริงหลังรวม spread ถึง SL) ดูการวาง SL ที่กลุ่ม Execution & costs")
color  buyCol      = input.color(#089981, "BUY", inline = "sigc", group = G_SIG)
color  sellCol     = input.color(#f23645, "SELL", inline = "sigc", group = G_SIG)

bool   showStats   = input.bool(true, "Show backtest stats", inline = "bt", group = G_SIG,
     tooltip = "ทดสอบย้อนหลังทุกสัญญาณบนข้อมูลที่โหลดในกราฟ: ชนะเมื่อโดน TP ก่อน, แพ้เมื่อโดน SL ก่อน (ถ้าแท่งเดียวโดนทั้งคู่ นับเป็นแพ้)")
string statsPos    = input.string("Bottom Left", "", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], inline = "bt", group = G_SIG)
bool   statsCompact = input.bool(true, "Compact stats table", group = G_SIG,
     tooltip = "แสดงเฉพาะแถวหลัก (Trades, Win rate, Expectancy, Net, PF, Max DD, Avg SL/hold) ปิดเพื่อดูรายละเอียดทั้งหมด")

string entryModel  = input.string("LTF CHoCH (sweep + displacement)", "Entry model", options = ["LTF CHoCH (sweep + displacement)", "Zone retest (bar close)"], group = G_LTF,
     tooltip = "LTF CHoCH = ราคาเข้าโซน HTF → กวาด swing low/high ย่อยของกราฟ → CHoCH ด้วยแท่งแรงที่ทิ้ง FVG → เข้าตอนราคาย้อนมาที่ FVG, SL หลังจุดที่กวาด (กราฟ = TF สำหรับเข้าเทรด แนะนำ 3m–5m)\nZone retest = แบบเดิม: ไส้เทียนแตะโซนแล้วปิดกลับ เข้าที่ราคาปิด")
string ltfEntry    = input.string("FVG edge", "LTF entry", options = ["FVG edge", "FVG 50%", "Market on confirm"], group = G_LTF,
     tooltip = "FVG edge = Limit ที่ขอบ FVG ฝั่งใกล้ราคา (ได้เข้าบ่อยกว่า)\nFVG 50% = Limit ที่กึ่งกลาง FVG (R:R ดีกว่า แต่บางครั้งไม่ได้เข้า)\nMarket on confirm = เข้าทันทีที่ราคาปิดแท่งยืนยัน")
bool   needSweep   = input.bool(true, "Require liquidity sweep", group = G_LTF,
     tooltip = "ต้องมีไส้เทียนทะลุ swing low (BUY) / swing high (SELL) ย่อยล่าสุด ระหว่างที่ราคาอยู่ในโซน ก่อนเกิด CHoCH")
int    ltfLen      = input.int(2, "Internal swing length", minval = 1, maxval = 10, group = G_LTF,
     tooltip = "จำนวนแท่งซ้าย/ขวาสำหรับ swing ย่อยของกราฟ ที่ใช้หา sweep และ CHoCH (ค่าน้อย = ไวขึ้น)")
float  dispBody    = input.float(0.5, "Displacement: body ≥ x range", minval = 0, maxval = 1, step = 0.05, inline = "disp", group = G_LTF)
float  dispAtr     = input.float(0.8, "and range ≥ x ATR", minval = 0, step = 0.1, inline = "disp", group = G_LTF,
     tooltip = "แท่งกลางของ FVG ต้องเป็นแท่งแรง: ตัวเทียน ≥ x ของความยาวแท่ง และความยาวแท่ง ≥ x × ATR14")
int    armBars     = input.int(12, "Setup window (bars)", minval = 3, maxval = 100, group = G_LTF,
     tooltip = "หลังราคาแตะโซน ต้องเกิด sweep + CHoCH + FVG ภายในจำนวนแท่งนี้ของกราฟ ไม่งั้นยกเลิก setup (กราฟ 5m: 12 แท่ง = 1 ชั่วโมง)")

float  spreadPx    = input.float(0.30, "Spread", minval = 0, step = 0.05, inline = "cost", group = G_EXEC)
float  slipPx      = input.float(0.10, "Slippage", minval = 0, step = 0.05, inline = "cost", group = G_EXEC,
     tooltip = "หน่วยเป็นราคา (XAUUSD: 0.30 = 30 cents) ใช้คำนวณ backtest แบบมีต้นทุน\nกราฟถือเป็นราคา Bid: BUY เข้าที่ Ask (+spread +slippage), SELL โดน SL เมื่อ Ask แตะ\nSlippage คิดกับคำสั่ง market และ stop (TP เป็น limit ไม่มี slippage)\nXAUUSD ช่วงตลาดคึกคักประมาณ 0.20–0.40 ถ้าใช้กับสินค้าอื่นต้องปรับค่านี้")
int    limitBars   = input.int(4, "Limit order valid (bars)", minval = 1, maxval = 50, group = G_EXEC,
     tooltip = "คำสั่ง Limit ที่ยังไม่ได้เข้า จะถูกยกเลิกเมื่อครบจำนวนแท่งนี้ หรือเมื่อราคาไปถึง TP ก่อน")
string entryMode   = input.string("Market (bar close)", "Retest entry", options = ["Market (bar close)", "Limit at zone edge"], group = G_EXEC,
     tooltip = "ใช้เฉพาะ Entry model = Zone retest\nMarket = เข้าที่ราคาปิดแท่งสัญญาณ\nLimit at zone edge = ตั้ง limit ที่ขอบโซนฝั่งใกล้ราคา")
string slMode      = input.string("Signal wick", "Retest stop-loss at", options = ["Signal wick", "Zone edge"], group = G_EXEC,
     tooltip = "ใช้เฉพาะ Entry model = Zone retest (LTF CHoCH วาง SL หลังจุดที่กวาดเสมอ)\nSignal wick = ใต้ไส้เทียนต่ำสุด (BUY) / เหนือไส้สูงสุด (SELL) ของแท่งสัญญาณและแท่งก่อนหน้า คือจุดที่กวาด liquidity\nZone edge = เลยขอบโซนฝั่งไกล (แบบเดิม มักกว้างกว่ามาก)\nSELL บวก spread ให้อัตโนมัติ เพราะ SL ของ SELL โดนด้วยราคา Ask")
float  bufSpread   = input.float(2.0, "SL buffer: x spread", minval = 0, step = 0.5, inline = "buf", group = G_EXEC)
float  bufAtr      = input.float(0.15, "or x ATR", minval = 0, step = 0.05, inline = "buf", group = G_EXEC,
     tooltip = "ระยะเผื่อของ SL = ค่าที่มากกว่าระหว่าง (x × spread) กับ (x × ATR14 ของกราฟ)")
float  minSlSpread = input.float(3.0, "Skip if SL < x spread", minval = 0, step = 0.5, group = G_EXEC,
     tooltip = "ไม่เข้าเทรดถ้า SL แคบเกินไปเทียบ spread เพราะต้นทุนจะกินกำไรเกือบหมด")
float  maxSlAtr    = input.float(3.0, "Skip if SL > x ATR", minval = 0, step = 0.25, group = G_EXEC,
     tooltip = "ไม่เข้าเทรดถ้า SL กว้างเกิน x × ATR14 ของกราฟ (0 = ไม่จำกัด) กันเทรดที่ความเสี่ยงใหญ่เกินสำหรับการเทรดสั้น")
float  maxChase    = input.float(0.5, "Skip if close ran > x R from zone", minval = 0, step = 0.1, group = G_EXEC,
     tooltip = "เฉพาะ Market entry: ถ้าแท่งสัญญาณปิดห่างจากขอบโซนเกิน x เท่าของ Risk แปลว่าราคาวิ่งไปแล้ว ไม่ไล่ราคา (0 = ปิด)")
int    maxHold     = input.int(120, "Time stop (minutes, 0 = off)", minval = 0, step = 15, group = G_EXEC,
     tooltip = "ถ้าเทรดยังไม่โดน TP/SL ภายในเวลานี้ ปิดที่ราคาปิดแท่ง (นับใน backtest)")
bool   onePos      = input.bool(true, "One position at a time", group = G_EXEC,
     tooltip = "ระหว่างที่มีออเดอร์ค้าง (รวม limit ที่รอ) สัญญาณใหม่จะถูกข้าม เหมือนการเทรดจริง")
bool   showUnfilled = input.bool(false, "Show unfilled limit orders (LMT ⌀)", group = G_EXEC,
     tooltip = "แสดงป้ายของคำสั่ง Limit ที่ราคาไม่ย้อนกลับมาให้เข้า (ไม่นับเป็นเทรด) ปิดไว้เพื่อลดความรก จำนวนดูได้ในตาราง (unfilled)")
bool   showSkipped = input.bool(false, "Show filtered signals (×)", group = G_EXEC,
     tooltip = "แสดงเครื่องหมาย × ตรงสัญญาณที่ถูกกรองทิ้ง เอาเมาส์ชี้เพื่อดูเหตุผล")

bool   useSess     = input.bool(true, "Trade only in sessions", group = G_TIME,
     tooltip = "ใช้กับกราฟ TF ไม่เกิน 1H เวลาอ้างอิงตามเมืองนั้น ๆ (ปรับ Daylight Saving อัตโนมัติ)\nค่าเริ่มต้น: London 07:00–12:00 และ New York 08:00–13:00 (ประมาณ 13:00–18:00 และ 19:00–00:00 เวลาไทยช่วงหน้าร้อนของฝั่งนั้น)")
bool   useLon      = input.bool(true, "London", inline = "lon", group = G_TIME)
string sessLon     = input.session("0700-1200", "", inline = "lon", group = G_TIME)
bool   useNY       = input.bool(true, "New York", inline = "ny", group = G_TIME)
string sessNY      = input.session("0800-1300", "", inline = "ny", group = G_TIME)
bool   blockRoll   = input.bool(true, "Block rollover (16:45–18:15 NY)", group = G_TIME,
     tooltip = "ช่วงเปลี่ยนวันของโบรกเกอร์ spread ทองถ่างมากและสภาพคล่องต่ำ")
bool   blockData   = input.bool(true, "Block US data window", inline = "data", group = G_TIME)
string sessData    = input.string("0820-0900:3456", "", inline = "data", group = G_TIME,
     tooltip = "เวลา New York, :3456 = อังคาร–ศุกร์ (ช่วงประกาศข่าว 08:30 เช่น CPI, NFP, Jobless Claims)")
const int NEWS_DEF = 1767274200000   // 2026-01-01 13:30 UTC (input.time needs a const default)
bool   news1On     = input.bool(false, "News 1", inline = "n1", group = G_TIME)
int    news1T      = input.time(NEWS_DEF, "", inline = "n1", group = G_TIME)
bool   news2On     = input.bool(false, "News 2", inline = "n2", group = G_TIME)
int    news2T      = input.time(NEWS_DEF, "", inline = "n2", group = G_TIME)
bool   news3On     = input.bool(false, "News 3", inline = "n3", group = G_TIME)
int    news3T      = input.time(NEWS_DEF, "", inline = "n3", group = G_TIME)
int    newsBefore  = input.int(15, "News window: min before", minval = 0, inline = "nw", group = G_TIME)
int    newsAfter   = input.int(30, "after", minval = 0, inline = "nw", group = G_TIME,
     tooltip = "ใส่เวลาข่าวแรงที่ไม่ได้ประกาศ 08:30 NY เช่น FOMC (14:00 NY) แล้วระบบจะไม่เข้าเทรดในช่วงก่อน/หลังข่าว")
bool   useVol      = input.bool(true, "ATR / avg ATR between", inline = "vol", group = G_TIME)
float  volMin      = input.float(0.6, "", minval = 0, step = 0.1, inline = "vol", group = G_TIME)
float  volMax      = input.float(2.5, "and", minval = 0, step = 0.1, inline = "vol", group = G_TIME,
     tooltip = "ATR14 เทียบค่าเฉลี่ย 100 แท่ง: ต่ำเกิน = ตลาดเงียบ spread กินกำไร, สูงเกิน = ช่วงข่าว/กระชาก SL หลุดง่าย")
bool   shadeSess   = input.bool(false, "Shade sessions / blocked times", group = G_TIME,
     tooltip = "แรเงาพื้นหลัง: สีฟ้า = ช่วง session ที่เทรด, สีแดง = ช่วงห้ามเทรด (rollover / ข่าว)")

bool   showDash    = input.bool(true, "Show trend dashboard", group = G_DASH)

// Effective HTFs (auto by chart TF, or manual)
int    chartS = timeframe.in_seconds(timeframe.period)
string eTf1   = autoHTF ? (chartS <= 60 ? "5" : chartS <= 300 ? "15" : chartS <= 900 ? "60" : chartS <= 3600 ? "240" : "D") : tf1
string eTf2   = autoHTF ? (chartS <= 60 ? "15" : chartS <= 300 ? "60" : chartS <= 900 ? "240" : chartS <= 3600 ? "D" : "W") : tf2
string eTf3   = autoHTF ? (chartS <= 60 ? "60" : chartS <= 300 ? "240" : chartS <= 900 ? "D" : chartS <= 3600 ? "W" : "M") : tf3
bool   eUse1  = autoHTF or useTF1
bool   eUse2  = autoHTF or useTF2
bool   eUse3  = autoHTF or useTF3

// Effective signal settings (preset or custom)
bool   isCustom = sigPreset == "Custom"
string eFilter  = isCustom ? sigFilter   : sigPreset == "Low" ? "HTF trend" : "HTF trend or CHoCH"
string eZoneTF  = isCustom ? sigZoneTF   : sigPreset == "Low" ? "HTF only" : sigPreset == "Medium" ? "HTF + chart OB" : "All TF"
bool   eUsePD   = isCustom ? usePD       : sigPreset == "Low" or sigPreset == "Medium"
float  eDepart  = isCustom ? sigDepart   : sigPreset == "Low" ? 1.0 : sigPreset == "Medium" ? 0.75 : 0.5
int    eCool    = isCustom ? sigCooldown : sigPreset == "Low" ? 120 : sigPreset == "Medium" ? 60 : sigPreset == "High" ? 30 : 15
string dashPos     = input.string("Top Right", "Position", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = G_DASH)

float  atrC    = ta.atr(14)
float  atrAvg  = ta.sma(atrC, 100)
float  lo2     = ta.lowest(low, 2)
float  hi2     = ta.highest(high, 2)
bool   isLTF   = entryModel != "Zone retest (bar close)"

// Internal (execution-TF) swings and displacement candles for the LTF entry model
float  iph     = ta.pivothigh(high, ltfLen, ltfLen)
float  ipl     = ta.pivotlow(low, ltfLen, ltfLen)
var float lastIPH = na
var float lastIPL = na
if not na(iph)
    lastIPH := iph
if not na(ipl)
    lastIPL := ipl
bool   dispUp1 = close[1] > open[1] and close[1] - open[1] >= dispBody * (high[1] - low[1]) and high[1] - low[1] >= dispAtr * atrC[1]
bool   dispDn1 = close[1] < open[1] and open[1] - close[1] >= dispBody * (high[1] - low[1]) and high[1] - low[1] >= dispAtr * atrC[1]
bool   dispBullFvg = low > high[2] and dispUp1      // FVG left by a bullish displacement candle (bar[1])
bool   dispBearFvg = high < low[2] and dispDn1
string lblSize = lblSizeOpt == "Tiny" ? size.tiny : lblSizeOpt == "Small" ? size.small : size.normal

//==============================================================================
// TYPES
//==============================================================================
type Zone
    box    bx
    float  top
    float  bot
    int    left
    bool   bull
    bool   isOB
    color  col
    int    rank        // 0 = chart TF, 1..3 = HTF slot (higher = more important)
    string tag         // timeframe name, e.g. "4H"
    string lbl         // base label text, e.g. "OB 4H"
    int    born        // chart bar_index when the zone was drawn
    bool   mitigated = false
    bool   signaled  = false
    bool   departed  = false   // price moved away from the zone at least once

//==============================================================================
// DETECTION (runs on any timeframe, also inside request.security)
//==============================================================================
// Returns: bull OB [flag, top, bottom, time], bear OB [...], bull FVG [...], bear FVG [...],
//          structure (1 = bull BOS, 2 = bull CHoCH, -1 = bear BOS, -2 = bear CHoCH),
//          broken level, broken level time, trend (1 / -1 / 0)
detect(int len, float minPct) =>
    var float swH      = na
    var int   swHBar   = na
    var int   swHTime  = na
    var bool  swHUsed  = true
    var float swL      = na
    var int   swLBar   = na
    var int   swLTime  = na
    var bool  swLUsed  = true
    var int   trend    = 0

    float atr = ta.atr(14)
    float cap = obMaxAtr * atr
    float ph  = ta.pivothigh(high, len, len)
    float pl  = ta.pivotlow(low, len, len)
    if not na(ph)
        swH     := ph
        swHBar  := bar_index - len
        swHTime := time[len]
        swHUsed := false
    if not na(pl)
        swL     := pl
        swLBar  := bar_index - len
        swLTime := time[len]
        swLUsed := false

    bool  bullOB  = false
    float bullOBT = na
    float bullOBB = na
    int   bullOBX = na
    bool  bearOB  = false
    float bearOBT = na
    float bearOBB = na
    int   bearOBX = na
    int   ms      = 0
    float msLvl   = na
    int   msX     = na

    // Bullish break of structure -> Order Block = candle with lowest low of the leg
    if not swHUsed and close > swH
        swHUsed := true
        ms      := trend < 0 ? 2 : 1
        msLvl   := swH
        msX     := swHTime
        trend   := 1
        int   span = math.max(1, math.min(bar_index - swHBar, 300))
        float mn   = low[1]
        int   idx  = 1
        for i = 1 to span
            if low[i] < mn
                mn  := low[i]
                idx := i
        bullOB  := true
        bullOBT := high[idx]
        bullOBB := low[idx]
        bullOBX := time[idx]
        // Oversized OB: keep the upper part (closest to price) or skip it
        if obMaxAtr > 0 and bullOBT - bullOBB > cap
            if obSizeMode == "Skip"
                bullOB := false
            else
                bullOBB := bullOBT - cap

    // Bearish break of structure -> Order Block = candle with highest high of the leg
    if not swLUsed and close < swL
        swLUsed := true
        ms      := trend > 0 ? -2 : -1
        msLvl   := swL
        msX     := swLTime
        trend   := -1
        int   span = math.max(1, math.min(bar_index - swLBar, 300))
        float mx   = high[1]
        int   idx  = 1
        for i = 1 to span
            if high[i] > mx
                mx  := high[i]
                idx := i
        bearOB  := true
        bearOBT := high[idx]
        bearOBB := low[idx]
        bearOBX := time[idx]
        // Oversized OB: keep the lower part (closest to price) or skip it
        if obMaxAtr > 0 and bearOBT - bearOBB > cap
            if obSizeMode == "Skip"
                bearOB := false
            else
                bearOBT := bearOBB + cap

    // Fair Value Gaps (3-candle imbalance)
    bool bullFVG = low > high[2] and close[1] > high[2] and (low - high[2]) / close * 100 >= minPct
    bool bearFVG = high < low[2] and close[1] < low[2] and (low[2] - high) / close * 100 >= minPct

    [bullOB, bullOBT, bullOBB, bullOBX,
     bearOB, bearOBT, bearOBB, bearOBX,
     bullFVG, low, high[2], time[2],
     bearFVG, low[2], high, time[2],
     ms, msLvl, msX, trend]

// Same as detect() but shifted one bar back -> used with lookahead_on for non-repainting HTF data
detectConfirmed(int len, float minPct) =>
    [a1, a2, a3, a4, b1, b2, b3, b4, c1, c2, c3, c4, d1, d2, d3, d4, m1, m2, m3, t] = detect(len, minPct)
    [a1[1], a2[1], a3[1], a4[1], b1[1], b2[1], b3[1], b4[1], c1[1], c2[1], c3[1], c4[1], d1[1], d2[1], d3[1], d4[1], m1[1], m2[1], m3[1], t[1]]

//==============================================================================
// HELPERS
//==============================================================================
tfName(simple string tf) =>
    int s = timeframe.in_seconds(tf)
    s >= 2592000 and s % 2592000 == 0 ? str.tostring(math.round(s / 2592000)) + "M" :
     s >= 604800 and s % 604800 == 0  ? str.tostring(math.round(s / 604800)) + "W" :
     s >= 86400 and s % 86400 == 0    ? str.tostring(math.round(s / 86400)) + "D" :
     s >= 3600 and s % 3600 == 0      ? str.tostring(math.round(s / 3600)) + "H" :
     s >= 60                          ? str.tostring(math.round(s / 60)) + "m" : str.tostring(s) + "s"

sameKind(Zone a, bool bull, bool isOB) => a.bull == bull and a.isOB == isOB

addZone(array<Zone> zs, float top, float bot, int t, bool bull, bool isOB, color c, int rank, string tag, int maxN) =>
    float nTop  = top
    float nBot  = bot
    int   nLeft = t
    // Overlapping active zone of the same kind on the same TF:
    // FVGs are merged into one zone, an older OB is replaced by the newer one
    int n = zs.size()
    if n > 0
        for i = n - 1 to 0
            Zone z = zs.get(i)
            if not z.mitigated and sameKind(z, bull, isOB) and z.top >= bot and z.bot <= top
                if not isOB
                    nTop  := math.max(nTop, z.top)
                    nBot  := math.min(nBot, z.bot)
                    nLeft := math.min(nLeft, z.left)
                z.bx.delete()
                zs.remove(i)
    string lbl = (isOB ? "OB" : "FVG") + (rank > 0 ? " " + tag : "")
    box bx = box.new(nLeft, nTop, time, nBot, xloc = xloc.bar_time, extend = extend.right,
         border_color = color.new(c, 30), border_style = rank > 0 ? line.style_dashed : line.style_solid,
         bgcolor = c, text = lbl, text_size = lblSize, text_color = color.new(c, 0),
         text_halign = text.align_right, text_valign = rank > 0 ? text.align_top : text.align_bottom)
    zs.unshift(Zone.new(bx, nTop, nBot, nLeft, bull, isOB, c, rank, tag, lbl, bar_index))
    // Keep at most maxN zones of this kind (newest first)
    array<int> drop = array.new<int>()
    int cnt = 0
    for i = 0 to zs.size() - 1
        if sameKind(zs.get(i), bull, isOB)
            cnt += 1
            if cnt > maxN
                drop.push(i)
    int d = drop.size()
    if d > 0
        for j = d - 1 to 0
            Zone old = zs.remove(drop.get(j))
            old.bx.delete()

// Mitigation check. Returns [bullTouch, bearTouch] for zones price is currently trading inside
updateZones(array<Zone> zs) =>
    bool bullTouch = false
    bool bearTouch = false
    int n = zs.size()
    if n > 0
        for i = n - 1 to 0
            Zone z = zs.get(i)
            if not z.mitigated
                bool hit = z.isOB ?
                     (obMitMode == "Close" ? (z.bull ? close < z.bot : close > z.top) : (z.bull ? low < z.bot : high > z.top)) :
                     (z.bull ? low <= z.bot : high >= z.top)
                if hit
                    z.mitigated := true
                    if hideMit
                        z.bx.delete()
                        zs.remove(i)
                    else
                        z.bx.set_extend(extend.none)
                        z.bx.set_right(time)
                        z.bx.set_bgcolor(color.new(chart.fg_color, 92))
                        z.bx.set_border_color(color.new(chart.fg_color, 80))
                        z.bx.set_text_color(color.new(chart.fg_color, 60))
                else if not z.departed and (z.bull ? low > z.top + eDepart * atrC : high < z.bot - eDepart * atrC)
                    z.departed := true
                else if high >= z.bot and low <= z.top
                    if z.bull
                        bullTouch := true
                    else
                        bearTouch := true
    [bullTouch, bearTouch]

fmt(float p) => str.tostring(p, format.mintick)

// Creates zones for one timeframe, returns [newBullOB, newBearOB, newBullFVG, newBearFVG]
handleSignals(bool isNew, int rank, string tag, array<Zone> zs,
     bool a1, float a2, float a3, int a4, bool b1, float b2, float b3, int b4,
     bool c1, float c2, float c3, int c4, bool d1, float d2, float d3, int d4) =>
    string sfx = " " + tag
    bool nbOB = isNew and showOB and a1
    bool nsOB = isNew and showOB and b1
    bool nbF  = isNew and showFVG and c1
    bool nsF  = isNew and showFVG and d1
    if nbOB
        addZone(zs, a2, a3, a4, true, true, bullOBCol, rank, tag, maxOB)
        alert(syminfo.ticker + " Bullish OB" + sfx + " : " + fmt(a3) + " - " + fmt(a2), alert.freq_once_per_bar)
    if nsOB
        addZone(zs, b2, b3, b4, false, true, bearOBCol, rank, tag, maxOB)
        alert(syminfo.ticker + " Bearish OB" + sfx + " : " + fmt(b3) + " - " + fmt(b2), alert.freq_once_per_bar)
    if nbF
        addZone(zs, c2, c3, c4, true, false, bullFVGCol, rank, tag, maxFVG)
        alert(syminfo.ticker + " Bullish FVG" + sfx + " : " + fmt(c3) + " - " + fmt(c2), alert.freq_once_per_bar)
    if nsF
        addZone(zs, d2, d3, d4, false, false, bearFVGCol, rank, tag, maxFVG)
        alert(syminfo.ticker + " Bearish FVG" + sfx + " : " + fmt(d3) + " - " + fmt(d2), alert.freq_once_per_bar)
    [nbOB, nsOB, nbF, nsF]

// Higher-timeframe slot (non-repainting: only confirmed HTF bars are used)
var int chartSec = timeframe.in_seconds(timeframe.period)

htfSlot(simple string tf, bool use, array<Zone> zs, int rank) =>
    [a1, a2, a3, a4, b1, b2, b3, b4, c1, c2, c3, c4, d1, d2, d3, d4, m1, m2, m3, t] =
         request.security(syminfo.tickerid, tf, detectConfirmed(swingLen, fvgMinPct), lookahead = barmerge.lookahead_on)
    bool valid = use and timeframe.in_seconds(tf) > chartSec
    bool isNew = valid and timeframe.change(tf)
    [nb, ns, nbf, nsf] = handleSignals(isNew, rank, tfName(tf), zs,
         a1, a2, a3, a4, b1, b2, b3, b4, c1, c2, c3, c4, d1, d2, d3, d4)
    [valid, t, nb or nbf, ns or nsf]

// BUY: wick into a bullish zone, bullish candle closes back above it (SELL mirrored).
// Returns [buy, buy zone bottom, buy zone top, sell, sell zone top, sell zone bottom]; a zone fires only once.
scanSignals(array<Zone> zs, bool allowBuy, bool allowSell, int minRank) =>
    bool  buy  = false
    bool  sell = false
    float bBot = na
    float bTop = na
    float sTop = na
    float sBot = na
    for z in zs
        bool typeOk = sigZones == "OB + FVG" or (sigZones == "OB only") == z.isOB
        if not z.mitigated and not z.signaled and z.departed and bar_index > z.born and (z.rank >= minRank or (eZoneTF == "HTF + chart OB" and z.isOB)) and typeOk
            if allowBuy and z.bull and low <= z.top and close > z.top and close > open
                buy        := true
                z.signaled := true
                bBot       := na(bBot) ? z.bot : math.min(bBot, z.bot)
                bTop       := na(bTop) ? z.top : math.max(bTop, z.top)
            if allowSell and not z.bull and high >= z.bot and close < z.bot and close < open
                sell       := true
                z.signaled := true
                sTop       := na(sTop) ? z.top : math.max(sTop, z.top)
                sBot       := na(sBot) ? z.bot : math.min(sBot, z.bot)
    [buy, bBot, bTop, sell, sTop, sBot]

// LTF model: active (fresh, departed, unused) zones that price is trading in on this bar.
// Returns [bull touch, bull top, bull bottom, bear touch, bear top, bear bottom] (outer bounds of all touched zones).
scanTouch(array<Zone> zs, int minRank) =>
    bool  bT   = false
    bool  sT   = false
    float bTop = na
    float bBot = na
    float sTop = na
    float sBot = na
    for z in zs
        bool typeOk = sigZones == "OB + FVG" or (sigZones == "OB only") == z.isOB
        if not z.mitigated and not z.signaled and z.departed and bar_index > z.born and z.rank >= minRank and typeOk and high >= z.bot and low <= z.top
            if z.bull
                bT   := true
                bTop := na(bTop) ? z.top : math.max(bTop, z.top)
                bBot := na(bBot) ? z.bot : math.min(bBot, z.bot)
            else
                sT   := true
                sTop := na(sTop) ? z.top : math.max(sTop, z.top)
                sBot := na(sBot) ? z.bot : math.min(sBot, z.bot)
    [bT, bTop, bBot, sT, sTop, sBot]

// Retire every same-side zone overlapping a price range (one trade per price area)
retireRange(array<Zone> zs, bool bull, float top, float bot) =>
    for z in zs
        if z.bull == bull and z.top >= bot and z.bot <= top
            z.signaled := true

//==============================================================================
// STATE
//==============================================================================
var array<Zone> zC  = array.new<Zone>()
var array<Zone> zH1 = array.new<Zone>()
var array<Zone> zH2 = array.new<Zone>()
var array<Zone> zH3 = array.new<Zone>()

//==============================================================================
// DISPLAY FILTER (nearest zones + higher-TF priority)
//==============================================================================
collect(array<Zone> src, array<Zone> dst) =>
    for z in src
        if not z.mitigated
            dst.push(z)

setVisible(Zone z, bool vis, string extra) =>
    z.bx.set_bgcolor(vis ? z.col : color(na))
    z.bx.set_border_color(vis ? color.new(z.col, 30) : color(na))
    z.bx.set_text_color(vis ? color.new(z.col, 0) : color(na))
    z.bx.set_text(z.lbl + extra)

refreshDisplay() =>
    array<Zone> pool = array.new<Zone>()
    collect(zC, pool)
    collect(zH1, pool)
    collect(zH2, pool)
    collect(zH3, pool)
    int n = pool.size()
    if n > 0
        array<bool>   hid   = array.new<bool>(n, false)
        array<string> extra = array.new<string>(n, "")
        // Lower-TF zone inside a higher-TF zone of the same kind -> show only the higher one (confluence label)
        if mergeTF
            for i = 0 to n - 1
                Zone a = pool.get(i)
                for j = 0 to n - 1
                    Zone b = pool.get(j)
                    if b.rank > a.rank and sameKind(b, a.bull, a.isOB) and b.top >= a.bot and b.bot <= a.top
                        hid.set(i, true)
                        if not str.contains(extra.get(j) + "+", "+" + a.tag + "+")
                            extra.set(j, extra.get(j) + "+" + a.tag)
                        break
        // Nearest N per side and type
        array<float> dist = array.new<float>(n, 0.0)
        for i = 0 to n - 1
            Zone z = pool.get(i)
            dist.set(i, z.bull ? math.max(0.0, close - z.top) : math.max(0.0, z.bot - close))
        array<int> ord = dist.sort_indices(order.ascending)
        array<int> cnt = array.new<int>(4, 0)
        for i in ord
            Zone z = pool.get(i)
            bool vis = not hid.get(i)
            if vis and nearestOnly
                int k = (z.isOB ? 0 : 2) + (z.bull ? 0 : 1)
                if cnt.get(k) >= nearestN
                    vis := false
                else
                    cnt.set(k, cnt.get(k) + 1)
            setVisible(z, vis, extra.get(i))

//==============================================================================
// MAIN
//==============================================================================
// Mitigation / touch checks first, so zones created on this bar are not mitigated by the same bar
bool bullTouch = false
bool bearTouch = false
if barstate.isconfirmed
    [bt0, st0] = updateZones(zC)
    [bt1, st1] = updateZones(zH1)
    [bt2, st2] = updateZones(zH2)
    [bt3, st3] = updateZones(zH3)
    bullTouch := bt0 or bt1 or bt2 or bt3
    bearTouch := st0 or st1 or st2 or st3

// Chart timeframe
string chartTag = tfName(timeframe.period)
[ca1, ca2, ca3, ca4, cb1, cb2, cb3, cb4, cc1, cc2, cc3, cc4, cd1, cd2, cd3, cd4, cms, cmsLvl, cmsX, cTrend] = detect(swingLen, fvgMinPct)
[cnb, cns, cnbf, cnsf] = handleSignals(showChartTF and barstate.isconfirmed, 0, chartTag, zC,
     ca1, ca2, ca3, ca4, cb1, cb2, cb3, cb4, cc1, cc2, cc3, cc4, cd1, cd2, cd3, cd4)

// Higher timeframes
[v1, t1, nBull1, nBear1] = htfSlot(eTf1, eUse1, zH1, 1)
[v2, t2, nBull2, nBear2] = htfSlot(eTf2, eUse2, zH2, 2)
[v3, t3, nBull3, nBear3] = htfSlot(eTf3, eUse3, zH3, 3)

//==============================================================================
// BUY / SELL SIGNALS
//==============================================================================
int   htfBias = v3 ? t3 : v2 ? t2 : v1 ? t1 : cTrend
// Reversal confirmation: CHoCH on the lowest enabled HTF (e.g. 1H when 1H + 4H are on), chart TF if only one HTF
int   nHTF     = (v1 ? 1 : 0) + (v2 ? 1 : 0) + (v3 ? 1 : 0)
int   revTrend = nHTF >= 2 ? (v1 ? t1 : t2) : cTrend
int   sigMinRank = eZoneTF != "All TF" and (v1 or v2 or v3) ? 1 : 0

// Premium / Discount of the bias timeframe's recent range (confirmed bars only)
string biasTF = v3 ? eTf3 : v2 ? eTf2 : v1 ? eTf1 : timeframe.period
[pdHi, pdLo] = request.security(syminfo.tickerid, biasTF, [ta.highest(high, pdLen)[1], ta.lowest(low, pdLen)[1]], lookahead = barmerge.lookahead_on)
float pdMid   = (pdHi + pdLo) / 2
bool  pdBuy   = not eUsePD or na(pdMid) or close < pdMid
bool  pdSell  = not eUsePD or na(pdMid) or close > pdMid
bool  biasBuy  = eFilter == "None" or (eFilter == "HTF trend" and htfBias > 0) or
     (eFilter == "HTF trend or CHoCH" and (htfBias > 0 or revTrend > 0)) or
     (eFilter == "Chart trend" and cTrend > 0) or (eFilter == "Both" and htfBias > 0 and cTrend > 0)
bool  biasSell = eFilter == "None" or (eFilter == "HTF trend" and htfBias < 0) or
     (eFilter == "HTF trend or CHoCH" and (htfBias < 0 or revTrend < 0)) or
     (eFilter == "Chart trend" and cTrend < 0) or (eFilter == "Both" and htfBias < 0 and cTrend < 0)
var int lastSig = na
bool  coolOk   = na(lastSig) or time - lastSig >= eCool * 60000
bool  canBuy   = showSig and barstate.isconfirmed and coolOk and biasBuy and pdBuy
bool  canSell  = showSig and barstate.isconfirmed and coolOk and biasSell and pdSell

// Session / news / volatility (time filters apply on intraday charts up to 1H)
bool  timeOn = timeframe.isintraday and chartSec <= 3600
bool  inLon  = useLon and not na(time(timeframe.period, sessLon, "Europe/London"))
bool  inNY   = useNY and not na(time(timeframe.period, sessNY, "America/New_York"))
bool  inRoll = blockRoll and not na(time(timeframe.period, "1645-1815", "America/New_York"))
bool  inData = blockData and not na(time(timeframe.period, sessData, "America/New_York"))
newsHit(bool on, int t) => on and time_close > t - newsBefore * 60000 and time < t + newsAfter * 60000
bool  inNews = newsHit(news1On, news1T) or newsHit(news2On, news2T) or newsHit(news3On, news3T)
bool  sessOk = not timeOn or not useSess or inLon or inNY
bool  newsOk = not timeOn or not (inRoll or inData or inNews)
float atrRel = atrC / atrAvg
bool  volOk  = not useVol or na(atrRel) or (atrRel >= volMin and atrRel <= volMax)
bgcolor(shadeSess and timeOn and showSig ? (not newsOk ? color.new(color.red, 92) : useSess and (inLon or inNY) ? color.new(color.blue, 95) : na) : na,
     title = "Session shading")

[sb0, sbb0, sbt0, ss0, sst0, ssb0] = scanSignals(zC, canBuy and not isLTF, canSell and not isLTF, sigMinRank)
[sb1, sbb1, sbt1, ss1, sst1, ssb1] = scanSignals(zH1, canBuy and not isLTF, canSell and not isLTF, sigMinRank)
[sb2, sbb2, sbt2, ss2, sst2, ssb2] = scanSignals(zH2, canBuy and not isLTF, canSell and not isLTF, sigMinRank)
[sb3, sbb3, sbt3, ss3, sst3, ssb3] = scanSignals(zH3, canBuy and not isLTF, canSell and not isLTF, sigMinRank)
bool  rawBuy  = sb0 or sb1 or sb2 or sb3
bool  rawSell = ss0 or ss1 or ss2 or ss3
// Conflicting signals on the same bar cancel each other
if rawBuy and rawSell
    rawBuy  := false
    rawSell := false

markTouched(array<Zone> zs, bool bull) =>
    for z in zs
        if z.bull == bull and high >= z.bot and low <= z.top
            z.signaled := true

minNa(float a, float b) => na(a) ? b : na(b) ? a : math.min(a, b)
maxNa(float a, float b) => na(a) ? b : na(b) ? a : math.max(a, b)
var line slLine = na
var line tpLine = na
var line enLine = na

//==============================================================================
// BACKTEST ENGINE (after costs; chart prices are treated as Bid)
//==============================================================================
type Trade
    label lb
    bool  isBuy
    float entry       // fill price (limit price while pending)
    float sl
    float tp
    float risk        // entry -> SL distance in price
    int   openTime
    int   expiryBar   // pending limit is cancelled after this bar
    bool  filled
    float cost        // estimated spread + slippage cost in R

type Stats
    int   tp        = 0
    int   sl        = 0
    int   tm        = 0
    int   miss      = 0
    float sumR      = 0.0
    float gWin      = 0.0
    float gLoss     = 0.0
    float peak      = 0.0
    float maxDD     = 0.0
    int   streak    = 0
    int   maxStreak = 0
    float sumRisk   = 0.0
    float sumCost   = 0.0
    float sumHold   = 0.0
    int   bN        = 0
    int   bW        = 0
    float bR        = 0.0
    int   sN        = 0
    int   sW        = 0
    float sR        = 0.0
    int   fPos      = 0
    int   fSess     = 0
    int   fNews     = 0
    int   fVol      = 0
    int   fSlMin    = 0
    int   fSlMax    = 0
    int   fChase    = 0
    int   fTrend    = 0
    int   fPD       = 0
    int   fCool     = 0
    int   setups    = 0
    int   taken     = 0

var array<Trade> trades = array.new<Trade>()
var Stats        S      = Stats.new()

// kind: 1 = TP, -1 = SL, 0 = time stop
closeTrade(Stats s, Trade t, float exitPx, int kind) =>
    float r = (t.isBuy ? exitPx - t.entry : t.entry - exitPx) / t.risk
    s.tp        := s.tp + (kind == 1 ? 1 : 0)
    s.sl        := s.sl + (kind == -1 ? 1 : 0)
    s.tm        := s.tm + (kind == 0 ? 1 : 0)
    s.sumR      := s.sumR + r
    s.gWin      := s.gWin + math.max(r, 0.0)
    s.gLoss     := s.gLoss + math.max(-r, 0.0)
    s.peak      := math.max(s.peak, s.sumR)
    s.maxDD     := math.max(s.maxDD, s.peak - s.sumR)
    s.streak    := r < 0 ? s.streak + 1 : 0
    s.maxStreak := math.max(s.maxStreak, s.streak)
    s.sumRisk   := s.sumRisk + t.risk
    s.sumCost   := s.sumCost + t.cost
    s.sumHold   := s.sumHold + (time_close - t.openTime) / 60000.0
    if t.isBuy
        s.bN := s.bN + 1
        s.bW := s.bW + (r > 0 ? 1 : 0)
        s.bR := s.bR + r
    else
        s.sN := s.sN + 1
        s.sW := s.sW + (r > 0 ? 1 : 0)
        s.sR := s.sR + r
    string mark = kind == 1 ? " ✔ " : kind == -1 ? " ✘ " : " ⏱ "
    t.lb.set_text((t.isBuy ? "BUY" : "SELL") + mark + (r >= 0 ? "+" : "") + str.tostring(r, "#.#") + "R")
    if r < 0
        t.lb.set_color(color.gray)
    r

// Resolve open / pending trades on this bar, before new signals (the entry bar itself is never counted).
// Same-bar SL and TP -> SL (conservative).
if barstate.isconfirmed and trades.size() > 0
    for i = trades.size() - 1 to 0
        Trade t    = trades.get(i)
        bool  done = false
        if not t.filled
            bool hitFill = t.isBuy ? low + spreadPx <= t.entry : high >= t.entry
            bool gone = t.isBuy ? high >= t.tp : low + spreadPx <= t.tp
            if hitFill
                t.filled   := true
                t.openTime := time
                t.lb.set_text(t.isBuy ? "BUY" : "SELL")
                if (t.isBuy ? low <= t.sl : high + spreadPx >= t.sl)
                    closeTrade(S, t, t.isBuy ? t.sl - slipPx : t.sl + slipPx, -1)
                    done := true
            else if gone or bar_index > t.expiryBar
                S.miss := S.miss + 1
                if showUnfilled
                    t.lb.set_text((t.isBuy ? "BUY" : "SELL") + " LMT ⌀")
                    t.lb.set_color(color.gray)
                else
                    t.lb.delete()
                done := true
        else
            bool hitSL = t.isBuy ? low <= t.sl : high + spreadPx >= t.sl
            bool hitTP = t.isBuy ? high >= t.tp : low + spreadPx <= t.tp
            if hitSL
                closeTrade(S, t, t.isBuy ? t.sl - slipPx : t.sl + slipPx, -1)
                done := true
            else if hitTP
                closeTrade(S, t, t.tp, 1)
                done := true
            else if maxHold > 0 and time_close - t.openTime >= maxHold * 60000
                closeTrade(S, t, t.isBuy ? close - slipPx : close + spreadPx + slipPx, 0)
                done := true
        if done
            trades.remove(i)

// Zone-retest model: entry / SL. Returns [entry, sl, chase]
planRetest(bool isBuy, float far, float near, bool lim) =>
    float buf   = math.max(bufSpread * spreadPx, bufAtr * atrC)
    float sl    = isBuy ? (slMode == "Signal wick" ? lo2 : far) - buf : (slMode == "Signal wick" ? hi2 : far) + spreadPx + buf
    float entry = lim ? near : isBuy ? close + spreadPx + slipPx : close - slipPx
    float chase = isBuy ? close - near : near - close
    [entry, sl, chase]

drawSignal(bool isBuy, bool lim, float entry, float sl, float tp, float risk, string info) =>
    color  c    = isBuy ? buyCol : sellCol
    string side = isBuy ? "BUY" : "SELL"
    string tip  = side + (lim ? " LIMIT" : "") + "\nEntry: " + fmt(entry) + "\nSL: " + fmt(sl) + "\nTP: " + fmt(tp) +
         "\nRisk: " + fmt(risk) + " (R:R 1:" + str.tostring(rrRatio) + ")" + info
    label lb = label.new(bar_index, close, side + (lim ? " LMT" : ""), yloc = isBuy ? yloc.belowbar : yloc.abovebar, color = c,
         textcolor = color.white, style = isBuy ? label.style_label_up : label.style_label_down, size = size.small, tooltip = tip)
    alert(syminfo.ticker + " " + side + (lim ? " LIMIT" : "") + " @ " + fmt(entry) + " | SL " + fmt(sl) + " | TP " + fmt(tp), alert.freq_once_per_bar_close)
    lb

//==============================================================================
// LTF ENTRY MODEL: HTF zone -> sweep -> CHoCH with displacement FVG -> entry at the FVG
//==============================================================================
int   ltfMinRank = eZoneTF == "All TF" ? 0 : (v1 or v2 or v3) ? 1 : 0
[tb0, tbt0, tbb0, ts0, tst0, tsb0] = scanTouch(zC, ltfMinRank)
[tb1, tbt1, tbb1, ts1, tst1, tsb1] = scanTouch(zH1, ltfMinRank)
[tb2, tbt2, tbb2, ts2, tst2, tsb2] = scanTouch(zH2, ltfMinRank)
[tb3, tbt3, tbb3, ts3, tst3, tsb3] = scanTouch(zH3, ltfMinRank)
bool  bTouch    = tb0 or tb1 or tb2 or tb3
bool  sTouch    = ts0 or ts1 or ts2 or ts3
float bTouchTop = maxNa(maxNa(tbt0, tbt1), maxNa(tbt2, tbt3))
float bTouchBot = minNa(minNa(tbb0, tbb1), minNa(tbb2, tbb3))
float sTouchTop = maxNa(maxNa(tst0, tst1), maxNa(tst2, tst3))
float sTouchBot = minNa(minNa(tsb0, tsb1), minNa(tsb2, tsb3))

// Bullish setup state
var bool  bArm    = false
var int   bArmB   = na
var float bArmTop = na
var float bArmBot = na
var float bSweep  = na     // lowest low since the zone was touched
var bool  bSwept  = false
var bool  bChoch  = false
var float bFvgT   = na
var float bFvgB   = na
// Bearish setup state
var bool  sArm    = false
var int   sArmB   = na
var float sArmTop = na
var float sArmBot = na
var float sSweep  = na     // highest high since the zone was touched
var bool  sSwept  = false
var bool  sChoch  = false
var float sFvgT   = na
var float sFvgB   = na

bool ltfBuy  = false
bool ltfSell = false
if isLTF and showSig and barstate.isconfirmed
    // Expire / invalidate (setup window over, or price closed through the whole zone)
    if bArm and (bar_index - bArmB > armBars or close < bArmBot)
        bArm := false
    if sArm and (bar_index - sArmB > armBars or close > sArmTop)
        sArm := false
    // Arm on a zone touch, or widen the zone range while armed
    if bTouch
        if not bArm
            bArm    := true
            bArmB   := bar_index
            bArmTop := bTouchTop
            bArmBot := bTouchBot
            bSweep  := low
            bSwept  := not needSweep
            bChoch  := false
            bFvgT   := na
            bFvgB   := na
        else
            bArmTop := math.max(bArmTop, bTouchTop)
            bArmBot := math.min(bArmBot, bTouchBot)
    if sTouch
        if not sArm
            sArm    := true
            sArmB   := bar_index
            sArmTop := sTouchTop
            sArmBot := sTouchBot
            sSweep  := high
            sSwept  := not needSweep
            sChoch  := false
            sFvgT   := na
            sFvgB   := na
        else
            sArmTop := math.max(sArmTop, sTouchTop)
            sArmBot := math.min(sArmBot, sTouchBot)
    // Progress: sweep -> displacement FVG -> CHoCH
    if bArm
        bSweep := math.min(bSweep, low)
        if not bSwept and not na(lastIPL) and low < lastIPL
            bSwept := true
        if bSwept and dispBullFvg
            bFvgT := low
            bFvgB := high[2]
        if bSwept and not na(lastIPH) and close > lastIPH
            bChoch := true
        ltfBuy := bChoch and not na(bFvgT)
    if sArm
        sSweep := math.max(sSweep, high)
        if not sSwept and not na(lastIPH) and high > lastIPH
            sSwept := true
        if sSwept and dispBearFvg
            sFvgT := low[2]
            sFvgB := high
        if sSwept and not na(lastIPL) and close < lastIPL
            sChoch := true
        ltfSell := sChoch and not na(sFvgB)
    // Conflicting setups on the same bar cancel each other
    if ltfBuy and ltfSell
        ltfBuy  := false
        ltfSell := false
        bArm    := false
        sArm    := false
    // A completed setup is consumed; it becomes a candidate only if bias / P-D / cooldown allow it
    if ltfBuy
        bArm   := false
        S.setups := S.setups + 1
        if not canBuy
            S.fCool  := S.fCool + (coolOk ? 0 : 1)
            S.fTrend := S.fTrend + (coolOk and not biasBuy ? 1 : 0)
            S.fPD    := S.fPD + (coolOk and biasBuy and not pdBuy ? 1 : 0)
        ltfBuy := canBuy
    if ltfSell
        sArm    := false
        S.setups := S.setups + 1
        if not canSell
            S.fCool  := S.fCool + (coolOk ? 0 : 1)
            S.fTrend := S.fTrend + (coolOk and not biasSell ? 1 : 0)
            S.fPD    := S.fPD + (coolOk and biasSell and not pdSell ? 1 : 0)
        ltfSell := canSell

//==============================================================================
// CANDIDATE -> FILTERS -> TRADE
//==============================================================================
bool   candBuy  = false
bool   candSell = false
float  cEntry   = na
float  cSl      = na
float  cChase   = 0.0
bool   cLim     = false
string cInfo    = ""
float  ltfBuf   = math.max(bufSpread * spreadPx, bufAtr * atrC)
if not isLTF and (rawBuy or rawSell)
    S.setups := S.setups + 1
    candBuy  := rawBuy
    candSell := rawSell
    markTouched(zC, rawBuy)
    markTouched(zH1, rawBuy)
    markTouched(zH2, rawBuy)
    markTouched(zH3, rawBuy)
    float far  = rawBuy ? minNa(minNa(sbb0, sbb1), minNa(sbb2, sbb3)) : maxNa(maxNa(sst0, sst1), maxNa(sst2, sst3))
    float near = rawBuy ? maxNa(maxNa(sbt0, sbt1), maxNa(sbt2, sbt3)) : minNa(minNa(ssb0, ssb1), minNa(ssb2, ssb3))
    cLim := entryMode == "Limit at zone edge"
    [e0, sl0, ch0] = planRetest(rawBuy, far, near, cLim)
    cEntry := e0
    cSl    := sl0
    cChase := ch0
    cInfo  := "\nModel: zone retest"
else if ltfBuy
    candBuy := true
    retireRange(zC, true, bArmTop, bArmBot)
    retireRange(zH1, true, bArmTop, bArmBot)
    retireRange(zH2, true, bArmTop, bArmBot)
    retireRange(zH3, true, bArmTop, bArmBot)
    cLim   := ltfEntry != "Market on confirm"
    cEntry := ltfEntry == "FVG edge" ? bFvgT : ltfEntry == "FVG 50%" ? (bFvgT + bFvgB) / 2 : close + spreadPx + slipPx
    cSl    := bSweep - ltfBuf
    cChase := close - bFvgT
    cInfo  := "\nModel: LTF CHoCH\nZone: " + fmt(bArmBot) + " – " + fmt(bArmTop) + "\nSweep low: " + fmt(bSweep) + "\nFVG: " + fmt(bFvgB) + " – " + fmt(bFvgT)
else if ltfSell
    candSell := true
    retireRange(zC, false, sArmTop, sArmBot)
    retireRange(zH1, false, sArmTop, sArmBot)
    retireRange(zH2, false, sArmTop, sArmBot)
    retireRange(zH3, false, sArmTop, sArmBot)
    cLim   := ltfEntry != "Market on confirm"
    cEntry := ltfEntry == "FVG edge" ? sFvgB : ltfEntry == "FVG 50%" ? (sFvgT + sFvgB) / 2 : close - slipPx
    cSl    := sSweep + spreadPx + ltfBuf
    cChase := sFvgB - close
    cInfo  := "\nModel: LTF CHoCH\nZone: " + fmt(sArmBot) + " – " + fmt(sArmTop) + "\nSweep high: " + fmt(sSweep) + "\nFVG: " + fmt(sFvgB) + " – " + fmt(sFvgT)

bool buySig  = false
bool sellSig = false
if candBuy or candSell
    bool   isBuy = candBuy
    float  risk  = isBuy ? cEntry - cSl : cSl - cEntry
    float  tp    = isBuy ? cEntry + rrRatio * risk : cEntry - rrRatio * risk
    string why   = ""
    if onePos and trades.size() > 0
        why    := "already in a position"
        S.fPos := S.fPos + 1
    else if not sessOk
        why     := "outside trading sessions"
        S.fSess := S.fSess + 1
    else if not newsOk
        why     := "news / rollover window"
        S.fNews := S.fNews + 1
    else if not volOk
        why    := "volatility out of range (ATR x" + str.tostring(atrRel, "#.##") + " of average)"
        S.fVol := S.fVol + 1
    else if na(risk) or risk <= 0 or (spreadPx > 0 and risk < minSlSpread * spreadPx)
        why      := "SL too small vs spread (" + fmt(risk) + ")"
        S.fSlMin := S.fSlMin + 1
    else if maxSlAtr > 0 and risk > maxSlAtr * atrC
        why      := "SL too wide (" + fmt(risk) + " = " + str.tostring(risk / atrC, "#.#") + " ATR)"
        S.fSlMax := S.fSlMax + 1
    else if not cLim and maxChase > 0 and cChase > maxChase * risk
        why      := "price already ran " + str.tostring(cChase / risk, "#.##") + "R from the entry zone"
        S.fChase := S.fChase + 1
    if why == ""
        buySig  := isBuy
        sellSig := not isBuy
        lastSig := time
        S.taken := S.taken + 1
        label lb = drawSignal(isBuy, cLim, cEntry, cSl, tp, risk, cInfo)
        trades.push(Trade.new(lb, isBuy, cEntry, cSl, tp, risk, time_close, bar_index + limitBars, not cLim, (spreadPx + (cLim ? 1 : 2) * slipPx) / risk))
        if showSLTP
            line.delete(slLine)
            line.delete(tpLine)
            line.delete(enLine)
            enLine := line.new(bar_index, cEntry, bar_index + 20, cEntry, color = chart.fg_color, style = line.style_dotted)
            slLine := line.new(bar_index, cSl, bar_index + 20, cSl, color = sellCol, width = 2)
            tpLine := line.new(bar_index, tp, bar_index + 20, tp, color = buyCol, width = 2)
    else if showSkipped
        label.new(bar_index, close, "×", yloc = isBuy ? yloc.belowbar : yloc.abovebar, color = color(na), textcolor = color.gray,
             style = label.style_none, size = size.normal, tooltip = (isBuy ? "BUY" : "SELL") + " skipped: " + why + cInfo)

if barstate.islast
    refreshDisplay()

// Market structure (BOS / CHoCH) on chart timeframe
bool msShow = msMode == "All" ? cms != 0 : msMode == "CHoCH only" ? math.abs(cms) == 2 : false
if msShow and barstate.isconfirmed
    color  c   = cms > 0 ? msBullCol : msBearCol
    string txt = math.abs(cms) == 2 ? "CHoCH" : "BOS"
    line.new(cmsX, cmsLvl, time, cmsLvl, xloc = xloc.bar_time, color = c, style = line.style_dashed)
    label.new(int(math.avg(cmsX, time)), cmsLvl, txt, xloc = xloc.bar_time, color = color(na), textcolor = c,
         style = cms > 0 ? label.style_label_down : label.style_label_up, size = size.tiny)
    alert(syminfo.ticker + " " + (cms > 0 ? "Bullish " : "Bearish ") + txt + " @ " + fmt(cmsLvl), alert.freq_once_per_bar)

//==============================================================================
// ALERT CONDITIONS
//==============================================================================
bool anyBull = cnb or cnbf or nBull1 or nBull2 or nBull3
bool anyBear = cns or cnsf or nBear1 or nBear2 or nBear3
alertcondition(anyBull, "New Bullish OB/FVG (any TF)", "{{ticker}} new Bullish Order Block / FVG")
alertcondition(anyBear, "New Bearish OB/FVG (any TF)", "{{ticker}} new Bearish Order Block / FVG")
alertcondition(bullTouch, "Price in Bullish zone", "{{ticker}} price entered Bullish OB/FVG zone @ {{close}}")
alertcondition(bearTouch, "Price in Bearish zone", "{{ticker}} price entered Bearish OB/FVG zone @ {{close}}")
alertcondition(buySig, "BUY signal", "{{ticker}} BUY @ {{close}}")
alertcondition(sellSig, "SELL signal", "{{ticker}} SELL @ {{close}}")
alertcondition(msShow and cms > 0, "Bullish BOS/CHoCH", "{{ticker}} Bullish structure break @ {{close}}")
alertcondition(msShow and cms < 0, "Bearish BOS/CHoCH", "{{ticker}} Bearish structure break @ {{close}}")

//==============================================================================
// DASHBOARD
//==============================================================================
posOf(string s) =>
    s == "Top Right" ? position.top_right : s == "Bottom Right" ? position.bottom_right : s == "Top Left" ? position.top_left : position.bottom_left

statRow(table t, int row, string k, string v, color c) =>
    t.cell(0, row, k, text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    t.cell(1, row, v, text_color = c, text_size = size.small, text_halign = text.align_right)

rStr(float r) => (r >= 0 ? "+" : "") + str.tostring(r, "#.##") + " R"

sideStat(int n, int w, float r) =>
    n > 0 ? str.tostring(n) + " · " + str.tostring(100.0 * w / n, "#") + "% · " + rStr(r) : "-"

topFilter(Stats s) =>
    array<int>    v = array.from(s.fSess, s.fNews, s.fVol, s.fSlMin, s.fSlMax, s.fChase, s.fPos, s.fTrend, s.fPD, s.fCool)
    array<string> k = array.from("session", "news", "volatility", "SL too small", "SL too wide", "chase", "in position", "trend", "P/D", "cooldown")
    int best = int(v.max())
    best > 0 ? k.get(v.indexof(best)) + " " + str.tostring(best) : "-"

if showStats and showSig and barstate.islast
    var table st = table.new(posOf(statsPos), 2, statsCompact ? 11 : 18, bgcolor = color.new(chart.bg_color, 10), border_color = color.new(chart.fg_color, 80),
         border_width = 1, frame_color = color.new(chart.fg_color, 70), frame_width = 1)
    int   closed = S.tp + S.sl + S.tm
    int   wins   = S.bW + S.sW
    float wr     = closed > 0 ? 100.0 * wins / closed : na
    float expR   = closed > 0 ? S.sumR / closed : na
    float pf     = S.gLoss > 0 ? S.gWin / S.gLoss : na
    color good   = msBullCol
    color bad    = msBearCol
    color fg     = chart.fg_color
    string model = isLTF ? "LTF CHoCH" : "Zone retest"
    st.cell(0, 0, "Backtest · " + model + " · after costs · R:R 1:" + str.tostring(rrRatio), text_color = fg, text_size = size.small)
    st.merge_cells(0, 0, 1, 0)
    statRow(st, 1, "Trades (closed / open)", str.tostring(closed) + " / " + str.tostring(trades.size()), fg)
    statRow(st, 2, "TP / SL / Time stop", str.tostring(S.tp) + " / " + str.tostring(S.sl) + " / " + str.tostring(S.tm), fg)
    statRow(st, 3, "Win rate", na(wr) ? "-" : str.tostring(wr, "#.#") + "%", fg)
    statRow(st, 4, "Expectancy / trade", na(expR) ? "-" : rStr(expR), na(expR) ? fg : expR > 0 ? good : bad)
    statRow(st, 5, "Net result", rStr(S.sumR), S.sumR >= 0 ? good : bad)
    statRow(st, 6, "Profit factor", na(pf) ? "-" : str.tostring(pf, "#.##"), na(pf) ? fg : pf >= 1 ? good : bad)
    statRow(st, 7, "Max drawdown", "-" + str.tostring(S.maxDD, "#.#") + " R", fg)
    statRow(st, 8, "Avg SL / hold", closed > 0 ? fmt(S.sumRisk / closed) + " / " + str.tostring(S.sumHold / closed, "#") + " min" : "-", fg)
    statRow(st, 9, "Setups → trades", str.tostring(S.setups) + " → " + str.tostring(S.taken) + " (top filter: " + topFilter(S) + ")", fg)
    if isLTF and chartSec > 300
        st.cell(0, 10, "⚠ LTF model is built for a 1m–5m chart (now " + chartTag + ")", text_color = bad, text_size = size.small)
        st.merge_cells(0, 10, 1, 10)
    if not statsCompact
        statRow(st, 11, "Max losing streak", str.tostring(S.maxStreak), fg)
        statRow(st, 12, "Avg cost", closed > 0 ? str.tostring(S.sumCost / closed, "#.##") + " R" : "-", fg)
        statRow(st, 13, "BUY (n · win · net)", sideStat(S.bN, S.bW, S.bR), fg)
        statRow(st, 14, "SELL (n · win · net)", sideStat(S.sN, S.sW, S.sR), fg)
        statRow(st, 15, "Filtered: time", "session " + str.tostring(S.fSess) + " · news " + str.tostring(S.fNews) + " · vol " + str.tostring(S.fVol), fg)
        statRow(st, 16, "Filtered: setup", "SL< " + str.tostring(S.fSlMin) + " · SL> " + str.tostring(S.fSlMax) + " · chase " + str.tostring(S.fChase) +
             " · in pos " + str.tostring(S.fPos) + " · unfilled " + str.tostring(S.miss), fg)
        statRow(st, 17, "Filtered: bias", "trend " + str.tostring(S.fTrend) + " · P/D " + str.tostring(S.fPD) + " · cooldown " + str.tostring(S.fCool), fg)

trendCell(table tb, int row, string name, int tr) =>
    string txt = tr > 0 ? "▲ Bullish" : tr < 0 ? "▼ Bearish" : "– Neutral"
    color  c   = tr > 0 ? msBullCol : tr < 0 ? msBearCol : color.gray
    tb.cell(0, row, name, text_color = chart.fg_color, text_size = size.small)
    tb.cell(1, row, txt, text_color = color.white, bgcolor = color.new(c, 20), text_size = size.small)

if showDash and barstate.islast
    string p = dashPos == "Top Right" ? position.top_right : dashPos == "Bottom Right" ? position.bottom_right :
         dashPos == "Top Left" ? position.top_left : position.bottom_left
    var table tb = table.new(p, 2, 5, bgcolor = color.new(chart.bg_color, 10), border_color = color.new(chart.fg_color, 80),
         border_width = 1, frame_color = color.new(chart.fg_color, 70), frame_width = 1)
    tb.clear(0, 0, 1, 4)
    tb.cell(0, 0, "TF", text_color = chart.fg_color, text_size = size.small)
    tb.cell(1, 0, "Trend", text_color = chart.fg_color, text_size = size.small)
    int row = 1
    trendCell(tb, row, chartTag + " (chart)", cTrend)
    if v1
        row += 1
        trendCell(tb, row, tfName(eTf1), t1)
    if v2
        row += 1
        trendCell(tb, row, tfName(eTf2), t2)
    if v3
        row += 1
        trendCell(tb, row, tfName(eTf3), t3)
