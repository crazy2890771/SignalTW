// Effective HTFs (fixed set, auto by chart TF, or manual)
int    chartS   = timeframe.in_seconds(timeframe.period)
bool   fixedSet = tfMode == "5m · 15m · 1H · 4H · 1D"
bool   autoSet  = tfMode == "Auto by chart TF"
string eTf1     = fixedSet ? "5" : autoSet ? (chartS <= 60 ? "5" : chartS <= 300 ? "15" : chartS <= 900 ? "60" : chartS <= 3600 ? "240" : "D") : tf1
string eTf2     = fixedSet ? "15" : autoSet ? (chartS <= 60 ? "15" : chartS <= 300 ? "60" : chartS <= 900 ? "240" : chartS <= 3600 ? "D" : "W") : tf2
string eTf3     = fixedSet ? "60" : autoSet ? (chartS <= 60 ? "60" : chartS <= 300 ? "240" : chartS <= 900 ? "D" : chartS <= 3600 ? "W" : "M") : tf3
string eTf4     = fixedSet ? "240" : tf4
string eTf5     = fixedSet ? "D" : tf5
bool   eUse1    = fixedSet or autoSet or useTF1
bool   eUse2    = fixedSet or autoSet or useTF2
bool   eUse3    = fixedSet or autoSet or useTF3
bool   eUse4    = fixedSet or (not autoSet and useTF4)
bool   eUse5    = fixedSet or (not autoSet and useTF5)

float  atrC    = ta.atr(14)
string lblSize = lblSizeOpt == "Tiny" ? size.tiny : lblSizeOpt == "Small" ? size.small : size.normal

//==============================================================================
// TYPES
//==============================================================================
type Zone
    box    bx
    float  top
    float  bot
    int    left
    bool   bull
    bool   isOB
    color  col
    int    rank        // 0 = chart TF, 1..3 = HTF slot (higher = more important)
    string tag         // timeframe name, e.g. "4H"
    string lbl         // base label text, e.g. "OB 4H"
    int    born        // chart bar_index when the zone was drawn
    int    tfSec       // timeframe of the zone in seconds (for alerts)
    bool   mitigated = false
    bool   entered   = false   // price has traded into the zone at least once

//==============================================================================
// DETECTION (runs on any timeframe, also inside request.security)
//==============================================================================
// Returns: bull OB [flag, top, bottom, time], bear OB [...], bull FVG [...], bear FVG [...],
//          structure (1 = bull BOS, 2 = bull CHoCH, -1 = bear BOS, -2 = bear CHoCH),
//          broken level, broken level time, trend (1 / -1 / 0)
detect(int len, float minPct) =>
    var float swH      = na
    var int   swHBar   = na
    var int   swHTime  = na
    var bool  swHUsed  = true
    var float swL      = na
    var int   swLBar   = na
    var int   swLTime  = na
    var bool  swLUsed  = true
    var int   trend    = 0

    float atr = ta.atr(14)
    float cap = obMaxAtr * atr
    float ph  = ta.pivothigh(high, len, len)
    float pl  = ta.pivotlow(low, len, len)
    if not na(ph)
        swH     := ph
        swHBar  := bar_index - len
        swHTime := time[len]
        swHUsed := false
    if not na(pl)
        swL     := pl
        swLBar  := bar_index - len
        swLTime := time[len]
        swLUsed := false

    bool  bullOB  = false
    float bullOBT = na
    float bullOBB = na
    int   bullOBX = na
    bool  bearOB  = false
    float bearOBT = na
    float bearOBB = na
    int   bearOBX = na
    int   ms      = 0
    float msLvl   = na
    int   msX     = na

    // Bullish break of structure -> Order Block = candle with lowest low of the leg
    if not swHUsed and close > swH
        swHUsed := true
        ms      := trend < 0 ? 2 : 1
        msLvl   := swH
        msX     := swHTime
        trend   := 1
        int   span = math.max(1, math.min(bar_index - swHBar, 300))
        float mn   = low[1]
        int   idx  = 1
        for i = 1 to span
            if low[i] < mn
                mn  := low[i]
                idx := i
        bullOB  := true
        bullOBT := high[idx]
        bullOBB := low[idx]
        bullOBX := time[idx]
        // Oversized OB: keep the upper part (closest to price) or skip it
        if obMaxAtr > 0 and bullOBT - bullOBB > cap
            if obSizeMode == "Skip"
                bullOB := false
            else
                bullOBB := bullOBT - cap

    // Bearish break of structure -> Order Block = candle with highest high of the leg
    if not swLUsed and close < swL
        swLUsed := true
        ms      := trend > 0 ? -2 : -1
        msLvl   := swL
        msX     := swLTime
        trend   := -1
        int   span = math.max(1, math.min(bar_index - swLBar, 300))
        float mx   = high[1]
        int   idx  = 1
        for i = 1 to span
            if high[i] > mx
                mx  := high[i]
                idx := i
        bearOB  := true
        bearOBT := high[idx]
        bearOBB := low[idx]
        bearOBX := time[idx]
        // Oversized OB: keep the lower part (closest to price) or skip it
        if obMaxAtr > 0 and bearOBT - bearOBB > cap
            if obSizeMode == "Skip"
                bearOB := false
            else
                bearOBT := bearOBB + cap

    // Fair Value Gaps (3-candle imbalance)
    bool bullFVG = low > high[2] and close[1] > high[2] and (low - high[2]) / close * 100 >= minPct
    bool bearFVG = high < low[2] and close[1] < low[2] and (low[2] - high) / close * 100 >= minPct

    [bullOB, bullOBT, bullOBB, bullOBX,
     bearOB, bearOBT, bearOBB, bearOBX,
     bullFVG, low, high[2], time[2],
     bearFVG, low[2], high, time[2],
     ms, msLvl, msX, trend]

// Same as detect() but shifted one bar back -> used with lookahead_on for non-repainting HTF data
detectConfirmed(int len, float minPct) =>
    [a1, a2, a3, a4, b1, b2, b3, b4, c1, c2, c3, c4, d1, d2, d3, d4, m1, m2, m3, t] = detect(len, minPct)
    [a1[1], a2[1], a3[1], a4[1], b1[1], b2[1], b3[1], b4[1], c1[1], c2[1], c3[1], c4[1], d1[1], d2[1], d3[1], d4[1], m1[1], m2[1], m3[1], t[1]]

//==============================================================================
// HELPERS
//==============================================================================
tfName(simple string tf) =>
    int s = timeframe.in_seconds(tf)
    s >= 2592000 and s % 2592000 == 0 ? str.tostring(math.round(s / 2592000)) + "M" :
     s >= 604800 and s % 604800 == 0  ? str.tostring(math.round(s / 604800)) + "W" :
     s >= 86400 and s % 86400 == 0    ? str.tostring(math.round(s / 86400)) + "D" :
     s >= 3600 and s % 3600 == 0      ? str.tostring(math.round(s / 3600)) + "H" :
     s >= 60                          ? str.tostring(math.round(s / 60)) + "m" : str.tostring(s) + "s"

sameKind(Zone a, bool bull, bool isOB) => a.bull == bull and a.isOB == isOB

addZone(array<Zone> zs, float top, float bot, int t, bool bull, bool isOB, color c, int rank, string tag, int maxN, int tfSec) =>
    float nTop  = top
    float nBot  = bot
    int   nLeft = t
    // Overlapping active zone of the same kind on the same TF:
    // FVGs are merged into one zone, an older OB is replaced by the newer one
    int n = zs.size()
    if n > 0
        for i = n - 1 to 0
            Zone z = zs.get(i)
            if not z.mitigated and sameKind(z, bull, isOB) and z.top >= bot and z.bot <= top
                if not isOB
                    nTop  := math.max(nTop, z.top)
                    nBot  := math.min(nBot, z.bot)
                    nLeft := math.min(nLeft, z.left)
                z.bx.delete()
                zs.remove(i)
    string lbl = (isOB ? "OB" : "FVG") + (rank > 0 ? " " + tag : "")
    box bx = box.new(nLeft, nTop, time, nBot, xloc = xloc.bar_time, extend = extend.right,
         border_color = color.new(c, 30), border_style = rank > 0 ? line.style_dashed : line.style_solid,
         bgcolor = c, text = lbl, text_size = lblSize, text_color = color.new(c, 0),
         text_halign = text.align_right, text_valign = rank > 0 ? text.align_top : text.align_bottom)
    zs.unshift(Zone.new(bx, nTop, nBot, nLeft, bull, isOB, c, rank, tag, lbl, bar_index, tfSec))
    // Keep at most maxN zones of this kind (newest first)
    array<int> drop = array.new<int>()
    int cnt = 0
    for i = 0 to zs.size() - 1
        if sameKind(zs.get(i), bull, isOB)
            cnt += 1
            if cnt > maxN
                drop.push(i)
    int d = drop.size()
    if d > 0
        for j = d - 1 to 0
            Zone old = zs.remove(drop.get(j))
            old.bx.delete()

// Mitigation check (confirmed bars)
updateZones(array<Zone> zs) =>
    int n = zs.size()
    if n > 0
        for i = n - 1 to 0
            Zone z = zs.get(i)
            if not z.mitigated
                bool hit = z.isOB ?
                     (obMitMode == "Close" ? (z.bull ? close < z.bot : close > z.top) : (z.bull ? low < z.bot : high > z.top)) :
                     (z.bull ? low <= z.bot : high >= z.top)
                if hit
                    z.mitigated := true
                    if hideMit
                        z.bx.delete()
                        zs.remove(i)
                    else
                        z.bx.set_extend(extend.none)
                        z.bx.set_right(time)
                        z.bx.set_bgcolor(color.new(chart.fg_color, 92))
                        z.bx.set_border_color(color.new(chart.fg_color, 80))
                        z.bx.set_text_color(color.new(chart.fg_color, 60))

fmt(float p) => str.tostring(p, format.mintick)

tfOk(int sec) => (sec == 300 and al5) or (sec == 900 and al15) or (sec == 3600 and al60) or (sec == 14400 and al240) or (sec == 86400 and alD)

// First time price trades into a zone (once per zone, also intrabar on realtime bars).
// Returns [bullish entered, bearish entered, alert text] for the alert-enabled TFs and zone types.
checkEntry(array<Zone> zs) =>
    bool   bIn = false
    bool   sIn = false
    string msg = ""
    for z in zs
        if not z.mitigated and not z.entered and bar_index > z.born and high >= z.bot and low <= z.top
            z.entered := true
            if tfOk(z.tfSec) and (z.isOB ? alOB : alFVG)
                bIn := bIn or z.bull
                sIn := sIn or not z.bull
                msg := msg + (msg == "" ? "" : " | ") + (z.bull ? "Bullish " : "Bearish ") + (z.isOB ? "OB " : "FVG ") + z.tag + " " + fmt(z.bot) + "–" + fmt(z.top)
    [bIn, sIn, msg]

joinMsg(string a, string b) => a == "" ? b : b == "" ? a : a + " | " + b

// Creates zones for one timeframe, returns [newBullOB, newBearOB, newBullFVG, newBearFVG]
handleZones(bool isNew, int rank, string tag, int tfSec, array<Zone> zs,
     bool a1, float a2, float a3, int a4, bool b1, float b2, float b3, int b4,
     bool c1, float c2, float c3, int c4, bool d1, float d2, float d3, int d4) =>
    string sfx = " " + tag
    bool nbOB = isNew and showOB and a1
    bool nsOB = isNew and showOB and b1
    bool nbF  = isNew and showFVG and c1
    bool nsF  = isNew and showFVG and d1
    if nbOB
        addZone(zs, a2, a3, a4, true, true, bullOBCol, rank, tag, maxOB, tfSec)
        if alNew
            alert(syminfo.ticker + " Bullish OB" + sfx + " : " + fmt(a3) + " - " + fmt(a2), alert.freq_once_per_bar)
    if nsOB
        addZone(zs, b2, b3, b4, false, true, bearOBCol, rank, tag, maxOB, tfSec)
        if alNew
            alert(syminfo.ticker + " Bearish OB" + sfx + " : " + fmt(b3) + " - " + fmt(b2), alert.freq_once_per_bar)
    if nbF
        addZone(zs, c2, c3, c4, true, false, bullFVGCol, rank, tag, maxFVG, tfSec)
        if alNew
            alert(syminfo.ticker + " Bullish FVG" + sfx + " : " + fmt(c3) + " - " + fmt(c2), alert.freq_once_per_bar)
    if nsF
        addZone(zs, d2, d3, d4, false, false, bearFVGCol, rank, tag, maxFVG, tfSec)
        if alNew
            alert(syminfo.ticker + " Bearish FVG" + sfx + " : " + fmt(d3) + " - " + fmt(d2), alert.freq_once_per_bar)
    [nbOB, nsOB, nbF, nsF]

// Higher-timeframe slot (non-repainting: only confirmed HTF bars are used)
var int chartSec = timeframe.in_seconds(timeframe.period)

htfSlot(simple string tf, bool use, array<Zone> zs, int rank) =>
    [a1, a2, a3, a4, b1, b2, b3, b4, c1, c2, c3, c4, d1, d2, d3, d4, m1, m2, m3, t] =
         request.security(syminfo.tickerid, tf, detectConfirmed(swingLen, fvgMinPct), lookahead = barmerge.lookahead_on)
    bool valid = use and timeframe.in_seconds(tf) > chartSec
    bool isNew = valid and timeframe.change(tf)
    [nb, ns, nbf, nsf] = handleZones(isNew, rank, tfName(tf), timeframe.in_seconds(tf), zs,
         a1, a2, a3, a4, b1, b2, b3, b4, c1, c2, c3, c4, d1, d2, d3, d4)
    [valid, t, nb or nbf, ns or nsf]

//==============================================================================
// STATE
//==============================================================================
var array<Zone> zC  = array.new<Zone>()
var array<Zone> zH1 = array.new<Zone>()
var array<Zone> zH2 = array.new<Zone>()
var array<Zone> zH3 = array.new<Zone>()
var array<Zone> zH4 = array.new<Zone>()
var array<Zone> zH5 = array.new<Zone>()

//==============================================================================
// DISPLAY FILTER (nearest zones + higher-TF priority)
//==============================================================================
collect(array<Zone> src, array<Zone> dst) =>
    for z in src
        if not z.mitigated
            dst.push(z)

setVisible(Zone z, bool vis, string extra) =>
    z.bx.set_bgcolor(vis ? z.col : color(na))
    z.bx.set_border_color(vis ? color.new(z.col, 30) : color(na))
    z.bx.set_text_color(vis ? color.new(z.col, 0) : color(na))
    z.bx.set_text(z.lbl + extra)

refreshDisplay() =>
    array<Zone> pool = array.new<Zone>()
    collect(zC, pool)
    collect(zH1, pool)
    collect(zH2, pool)
    collect(zH3, pool)
    collect(zH4, pool)
    collect(zH5, pool)
    int n = pool.size()
    if n > 0
        array<bool>   hid   = array.new<bool>(n, false)
        array<string> extra = array.new<string>(n, "")
        // Lower-TF zone inside a higher-TF zone of the same kind -> show only the higher one (confluence label)
        if mergeTF
            for i = 0 to n - 1
                Zone a = pool.get(i)
                for j = 0 to n - 1
                    Zone b = pool.get(j)
                    if b.rank > a.rank and sameKind(b, a.bull, a.isOB) and b.top >= a.bot and b.bot <= a.top
                        hid.set(i, true)
                        if not str.contains(extra.get(j) + "+", "+" + a.tag + "+")
                            extra.set(j, extra.get(j) + "+" + a.tag)
                        break
        // Nearest N per side and type
        array<float> dist = array.new<float>(n, 0.0)
        for i = 0 to n - 1
            Zone z = pool.get(i)
            dist.set(i, z.bull ? math.max(0.0, close - z.top) : math.max(0.0, z.bot - close))
        array<int> ord = dist.sort_indices(order.ascending)
        array<int> cnt = array.new<int>(4, 0)
        for i in ord
            Zone z = pool.get(i)
            bool vis = not hid.get(i)
            if vis and nearestOnly
                int k = (z.isOB ? 0 : 2) + (z.bull ? 0 : 1)
                if cnt.get(k) >= nearestN
                    vis := false
                else
                    cnt.set(k, cnt.get(k) + 1)
            setVisible(z, vis, extra.get(i))

//==============================================================================
// MAIN
//==============================================================================
// Mitigation checks first, so zones created on this bar are not mitigated by the same bar
if barstate.isconfirmed
    updateZones(zC)
    updateZones(zH1)
    updateZones(zH2)
    updateZones(zH3)
    updateZones(zH4)
    updateZones(zH5)

// Chart timeframe
string chartTag = tfName(timeframe.period)
[ca1, ca2, ca3, ca4, cb1, cb2, cb3, cb4, cc1, cc2, cc3, cc4, cd1, cd2, cd3, cd4, cms, cmsLvl, cmsX, cTrend] = detect(swingLen, fvgMinPct)
[cnb, cns, cnbf, cnsf] = handleZones(showChartTF and barstate.isconfirmed, 0, chartTag, chartSec, zC,
     ca1, ca2, ca3, ca4, cb1, cb2, cb3, cb4, cc1, cc2, cc3, cc4, cd1, cd2, cd3, cd4)

// Higher timeframes
[v1, t1, nBull1, nBear1] = htfSlot(eTf1, eUse1, zH1, 1)
[v2, t2, nBull2, nBear2] = htfSlot(eTf2, eUse2, zH2, 2)
[v3, t3, nBull3, nBear3] = htfSlot(eTf3, eUse3, zH3, 3)
[v4, t4, nBull4, nBear4] = htfSlot(eTf4, eUse4, zH4, 4)
[v5, t5, nBull5, nBear5] = htfSlot(eTf5, eUse5, zH5, 5)

// Price entering a zone (every tick on realtime bars -> notification as soon as price reaches the zone)
[eb0, es0, em0] = checkEntry(zC)
[eb1, es1, em1] = checkEntry(zH1)
[eb2, es2, em2] = checkEntry(zH2)
[eb3, es3, em3] = checkEntry(zH3)
[eb4, es4, em4] = checkEntry(zH4)
[eb5, es5, em5] = checkEntry(zH5)
bool   enterBull = eb0 or eb1 or eb2 or eb3 or eb4 or eb5
bool   enterBear = es0 or es1 or es2 or es3 or es4 or es5
string enterMsg  = joinMsg(joinMsg(joinMsg(em0, em1), joinMsg(em2, em3)), joinMsg(em4, em5))
if alEnter and enterMsg != ""
    alert(syminfo.ticker + " " + fmt(close) + " entered " + enterMsg, alert.freq_once_per_bar)

//==============================================================================
// LIQUIDITY (PDH/PDL, PWH/PWL, Asia range, equal highs / lows) + sweep markers
//==============================================================================
type Liq
    line   ln
    label  lb
    float  price
    bool   up        // true = buy-side liquidity (above highs), false = sell-side (below lows)
    string name
    int    born
    bool   eq
    bool   done = false

var array<Liq> liqs = array.new<Liq>()
bool   liqOn  = showLiq and timeframe.isintraday
color  liqLn  = color.new(liqCol, 15)
color  liqTx  = liqCol

dropLiq(int i) =>
    Liq q = liqs.remove(i)
    q.ln.delete()
    q.lb.delete()

newLiq(float price, int t, bool up, string name, bool eq) =>
    line  ln = line.new(t, price, time, price, xloc = xloc.bar_time, extend = extend.right, color = liqLn, style = line.style_dotted)
    label lb = label.new(time, price, name, xloc = xloc.bar_time, style = label.style_label_left, color = color(na), textcolor = liqTx, size = size.tiny)
    liqs.push(Liq.new(ln, lb, price, up, name, bar_index, eq))
    // Keep the drawing budget: oldest finished levels first, then the oldest active EQ levels beyond maxEq
    int nEq = 0
    for q in liqs
        nEq += (q.eq and not q.done) ? 1 : 0
    while liqs.size() > 40 or nEq > maxEq
        int k = -1
        for j = 0 to liqs.size() - 1
            Liq c = liqs.get(j)
            if c.done or (nEq > maxEq and c.eq)
                k := j
                break
        if k < 0
            break
        nEq -= (liqs.get(k).eq and not liqs.get(k).done) ? 1 : 0
        dropLiq(k)

// Remove still-active levels with this name (a new session / day replaces them)
expireLiq(string name) =>
    int n = liqs.size()
    if n > 0
        for i = n - 1 to 0
            Liq q = liqs.get(i)
            if not q.done and q.name == name
                dropLiq(i)

// Equal highs / lows from chart-TF swings
float eph = ta.pivothigh(high, eqLen, eqLen)
float epl = ta.pivotlow(low, eqLen, eqLen)
var array<float> eqHp = array.new<float>()
var array<int>   eqHt = array.new<int>()
var array<float> eqLp = array.new<float>()
var array<int>   eqLt = array.new<int>()

// Session sources
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
bool  newDayL  = timeframe.change("D")
bool  newWeekL = timeframe.change("W")
bool  inAsia   = not na(time(timeframe.period, asiaSess, "UTC"))
var float asiaH = na
var float asiaL = na
var int   asiaT = na

string bslHit = ""   // buy-side levels swept this bar (wick above, close back below)
string sslHit = ""   // sell-side levels swept this bar (wick below, close back above)
if liqOn and barstate.isconfirmed
    // 1) Sweeps / breaks of existing levels
    for q in liqs
        if not q.done and bar_index > q.born and (q.up ? high > q.price : low < q.price)
            bool grab = q.up ? close < q.price : close > q.price
            q.done := true
            q.ln.set_extend(extend.none)
            q.ln.set_x2(time)
            q.ln.set_color(color.new(liqCol, 65))
            q.lb.set_x(time)
            q.lb.set_text(q.name + (grab ? " swept" : " taken"))
            q.lb.set_textcolor(color.new(liqCol, 50))
            if grab and q.up
                bslHit := bslHit == "" ? q.name : bslHit + ", " + q.name
            if grab and not q.up
                sslHit := sslHit == "" ? q.name : sslHit + ", " + q.name
    // 2) Daily / weekly levels
    if liqPD and newDayL and not na(pdh)
        expireLiq("PDH")
        expireLiq("PDL")
        newLiq(pdh, time, true, "PDH", false)
        newLiq(pdl, time, false, "PDL", false)
    if liqPW and newWeekL and not na(pwh)
        expireLiq("PWH")
        expireLiq("PWL")
        newLiq(pwh, time, true, "PWH", false)
        newLiq(pwl, time, false, "PWL", false)
    // 3) Asian range: track during the session, publish when it ends
    if liqAsia
        if inAsia and not inAsia[1]
            asiaH := high
            asiaL := low
            asiaT := time
        else if inAsia
            asiaH := math.max(asiaH, high)
            asiaL := math.min(asiaL, low)
        if not inAsia and inAsia[1] and not na(asiaH)
            expireLiq("Asia H")
            expireLiq("Asia L")
            newLiq(asiaH, asiaT, true, "Asia H", false)
            newLiq(asiaL, asiaT, false, "Asia L", false)
    // 4) Equal highs / lows: a new swing within tolerance of an earlier unswept swing
    if liqEq
        float tol = eqTol * atrC
        int nh = eqHp.size()
        if nh > 0
            for j = nh - 1 to 0
                if high > eqHp.get(j)
                    eqHp.remove(j)
                    eqHt.remove(j)
        int nl = eqLp.size()
        if nl > 0
            for j = nl - 1 to 0
                if low < eqLp.get(j)
                    eqLp.remove(j)
                    eqLt.remove(j)
        if not na(eph)
            int m = eqHp.size()
            if m > 0
                for j = m - 1 to 0
                    if math.abs(eqHp.get(j) - eph) <= tol
                        float lvl = math.max(eqHp.get(j), eph)
                        bool  dup = false
                        for q in liqs
                            dup := dup or (not q.done and q.up and q.eq and math.abs(q.price - lvl) <= tol)
                        if not dup
                            newLiq(lvl, eqHt.get(j), true, "EQH", true)
                        break
            eqHp.push(eph)
            eqHt.push(time[eqLen])
            if eqHp.size() > 20
                eqHp.shift()
                eqHt.shift()
        if not na(epl)
            int m = eqLp.size()
            if m > 0
                for j = m - 1 to 0
                    if math.abs(eqLp.get(j) - epl) <= tol
                        float lvl = math.min(eqLp.get(j), epl)
                        bool  dup = false
                        for q in liqs
                            dup := dup or (not q.done and not q.up and q.eq and math.abs(q.price - lvl) <= tol)
                        if not dup
                            newLiq(lvl, eqLt.get(j), false, "EQL", true)
                        break
            eqLp.push(epl)
            eqLt.push(time[eqLen])
            if eqLp.size() > 20
                eqLp.shift()
                eqLt.shift()
    // 5) Sweep markers
    if bslHit != ""
        label.new(bar_index, high, "$", yloc = yloc.abovebar, style = label.style_none, textcolor = liqCol, size = size.small,
             tooltip = "Buy-side liquidity swept: " + bslHit)
        if alLiq
            alert(syminfo.ticker + " swept buy-side liquidity (" + bslHit + ") @ " + fmt(high), alert.freq_once_per_bar_close)
    if sslHit != ""
        label.new(bar_index, low, "$", yloc = yloc.belowbar, style = label.style_none, textcolor = liqCol, size = size.small,
             tooltip = "Sell-side liquidity swept: " + sslHit)
        if alLiq
            alert(syminfo.ticker + " swept sell-side liquidity (" + sslHit + ") @ " + fmt(low), alert.freq_once_per_bar_close)

//==============================================================================
// BUY / SELL: HTF bias -> chart-TF CHoCH / BOS -> OB (+ FVG) of the impulse -> retest with a reaction
//==============================================================================
biasTrendFn(int len) =>
    [a1, a2, a3, a4, b1, b2, b3, b4, c1, c2, c3, c4, d1, d2, d3, d4, m1, m2, m3, t] = detect(len, fvgMinPct)
    t[1]

int  htfBiasT = request.security(syminfo.tickerid, biasTf, biasTrendFn(swingLen), lookahead = barmerge.lookahead_on)
bool biasOn   = timeframe.in_seconds(biasTf) > chartSec
int  bias     = biasOn ? htfBiasT : cTrend
string biasName = biasOn ? tfName(biasTf) : chartTag

// Lowest low (bull) / highest high (bear) from the OB candle to now = the structure point of the impulse leg
legExtreme(bool bull, int fromTime) =>
    float ext = bull ? low : high
    for i = 1 to 300
        if na(time[i]) or time[i] < fromTime
            break
        ext := bull ? math.min(ext, low[i]) : math.max(ext, high[i])
    ext

// Latest FVG on the chart TF (to check that the impulse left one)
var float lbFvgT = na
var float lbFvgB = na
var int   lbFvgX = na
var float lsFvgT = na
var float lsFvgB = na
var int   lsFvgX = na
if cc1
    lbFvgT := cc2
    lbFvgB := cc3
    lbFvgX := cc4
if cd1
    lsFvgT := cd2
    lsFvgB := cd3
    lsFvgX := cd4

// Armed setups waiting for the retest
var bool  bSet    = false
var int   bSetBar = na
var float bPoiT   = na
var float bPoiB   = na
var float bSL     = na
var box   bBox    = na
var bool  sSet    = false
var int   sSetBar = na
var float sPoiT   = na
var float sPoiB   = na
var float sSL     = na
var box   sBox    = na
var line  enLine  = na
var line  slLine  = na
var line  tpLine  = na

// Backtest: every signal is followed until TP or SL (chart = Bid; same-bar TP and SL counts as a loss)
type SigTrade
    label lb
    bool  isBuy
    float entry
    float sl
    float tp
    float risk

var array<SigTrade> sigTrades = array.new<SigTrade>()
var int   btW    = 0
var int   btL    = 0
var int   btBN   = 0
var int   btBW   = 0
var int   btSN   = 0
var int   btSW   = 0
var float btR    = 0.0
var float btGW   = 0.0
var float btGL   = 0.0
var float btPeak = 0.0
var float btDD   = 0.0
var float btRisk = 0.0

if showBT and barstate.isconfirmed and sigTrades.size() > 0
    for i = sigTrades.size() - 1 to 0
        SigTrade t = sigTrades.get(i)
        bool hitSL = t.isBuy ? low <= t.sl : high + btSpread >= t.sl
        bool hitTP = t.isBuy ? high >= t.tp : low + btSpread <= t.tp
        if hitSL or hitTP
            bool  win = hitTP and not hitSL
            float c   = t.isBuy ? btSpread / t.risk : 0.0     // a BUY fills at Ask; a SELL pays the spread through its Ask-triggered exits
            float r   = win ? sigRR - c : -1 - c
            btW    += win ? 1 : 0
            btL    += win ? 0 : 1
            btR    += r
            btGW   += math.max(r, 0.0)
            btGL   += math.max(-r, 0.0)
            btPeak := math.max(btPeak, btR)
            btDD   := math.max(btDD, btPeak - btR)
            btRisk += t.risk
            if t.isBuy
                btBN += 1
                btBW += win ? 1 : 0
            else
                btSN += 1
                btSW += win ? 1 : 0
            t.lb.set_text((t.isBuy ? "BUY" : "SELL") + (win ? " ✔ " : " ✘ ") + (r >= 0 ? "+" : "") + str.tostring(r, "#.#") + "R")
            if not win
                t.lb.set_color(color.gray)
            sigTrades.remove(i)

bool buySig  = false
bool sellSig = false
if showSig and barstate.isconfirmed
    // 1) Invalidate: closed through the stop, structure flipped, or waited too long
    if bSet and (close < bSL or cms < 0 or bar_index - bSetBar > setupBars)
        bSet := false
        box.delete(bBox)
    if sSet and (close > sSL or cms > 0 or bar_index - sSetBar > setupBars)
        sSet := false
        box.delete(sBox)
    // 2) Retest of the zone with a reaction candle, in the direction of the bias
    bool bullReact = close > open or math.min(open, close) - low >= 0.5 * (high - low)
    bool bearReact = close < open or high - math.max(open, close) >= 0.5 * (high - low)
    if bSet and bar_index > bSetBar and low <= bPoiT and close > bPoiB and bullReact and bias > 0 and close > bSL
        buySig := true
    if sSet and bar_index > sSetBar and high >= sPoiB and close < sPoiT and bearReact and bias < 0 and close < sSL
        sellSig := true
    if buySig and sellSig
        buySig  := false
        sellSig := false
    if buySig or sellSig
        bool   isBuy = buySig
        float  entry = close
        float  sl    = isBuy ? bSL : sSL
        float  risk  = math.abs(entry - sl)
        float  tp    = isBuy ? entry + sigRR * risk : entry - sigRR * risk
        string side  = isBuy ? "BUY" : "SELL"
        string zone  = isBuy ? fmt(bPoiB) + " – " + fmt(bPoiT) : fmt(sPoiB) + " – " + fmt(sPoiT)
        string tip   = side + "\nEntry: " + fmt(entry) + "\nSL: " + fmt(sl) + "\nTP: " + fmt(tp) + " (R:R 1:" + str.tostring(sigRR) + ")" +
             "\nBias " + biasName + ": " + (bias > 0 ? "Bullish" : "Bearish") + "\nZone: " + zone
        label lb = label.new(bar_index, close, side, yloc = isBuy ? yloc.belowbar : yloc.abovebar, color = isBuy ? buyCol : sellCol,
             textcolor = color.white, style = isBuy ? label.style_label_up : label.style_label_down, size = size.small, tooltip = tip)
        if showBT and risk > 0
            sigTrades.push(SigTrade.new(lb, isBuy, entry, sl, tp, risk))
        if showLevels
            line.delete(enLine)
            line.delete(slLine)
            line.delete(tpLine)
            enLine := line.new(bar_index, entry, bar_index + 20, entry, color = chart.fg_color, style = line.style_dotted)
            slLine := line.new(bar_index, sl, bar_index + 20, sl, color = sellCol, width = 2)
            tpLine := line.new(bar_index, tp, bar_index + 20, tp, color = buyCol, width = 2)
        if alSig
            alert(syminfo.ticker + " " + side + " @ " + fmt(entry) + " | SL " + fmt(sl) + " | TP " + fmt(tp) + " | zone " + zone, alert.freq_once_per_bar_close)
        if isBuy
            bSet := false
            box.delete(bBox)
        else
            sSet := false
            box.delete(sBox)
    // 3) Arm a new setup on a confirming break (replaces an older one on the same side)
    bool bullBreak = sigConfirm == "CHoCH → BOS" ? cms == 1 : cms > 0
    bool bearBreak = sigConfirm == "CHoCH → BOS" ? cms == -1 : cms < 0
    bool bFvgOk    = not na(lbFvgX) and lbFvgX >= ca4
    bool sFvgOk    = not na(lsFvgX) and lsFvgX >= cb4
    if bullBreak and ca1 and (bFvgOk or not needFvg)
        bSet    := true
        bSetBar := bar_index
        bPoiB   := ca3
        bPoiT   := bFvgOk and lbFvgB <= ca2 ? math.max(ca2, lbFvgT) : ca2
        bSL     := legExtreme(true, ca4) - slBufAtr * atrC
        box.delete(bBox)
        if showSetup
            bBox := box.new(ca4, bPoiT, time, bPoiB, xloc = xloc.bar_time, extend = extend.right, border_color = buyCol,
                 border_style = line.style_dotted, bgcolor = color.new(buyCol, 92), text = "BUY zone · wait retest",
                 text_size = size.tiny, text_color = buyCol, text_halign = text.align_left, text_valign = text.align_top)
    if bearBreak and cb1 and (sFvgOk or not needFvg)
        sSet    := true
        sSetBar := bar_index
        sPoiT   := cb2
        sPoiB   := sFvgOk and lsFvgT >= cb3 ? math.min(cb3, lsFvgB) : cb3
        sSL     := legExtreme(false, cb4) + slBufAtr * atrC
        box.delete(sBox)
        if showSetup
            sBox := box.new(cb4, sPoiT, time, sPoiB, xloc = xloc.bar_time, extend = extend.right, border_color = sellCol,
                 border_style = line.style_dotted, bgcolor = color.new(sellCol, 92), text = "SELL zone · wait retest",
                 text_size = size.tiny, text_color = sellCol, text_halign = text.align_left, text_valign = text.align_bottom)

if barstate.islast
    refreshDisplay()
    for q in liqs
        if not q.done
            q.lb.set_x(time)

// Market structure (BOS / CHoCH) on chart timeframe
bool msShow = msMode == "All" ? cms != 0 : msMode == "CHoCH only" ? math.abs(cms) == 2 : false
if msShow and barstate.isconfirmed
    color  c   = cms > 0 ? msBullCol : msBearCol
    string txt = math.abs(cms) == 2 ? "CHoCH" : "BOS"
    line.new(cmsX, cmsLvl, time, cmsLvl, xloc = xloc.bar_time, color = c, style = line.style_dashed)
    label.new(int(math.avg(cmsX, time)), cmsLvl, txt, xloc = xloc.bar_time, color = color(na), textcolor = c,
         style = cms > 0 ? label.style_label_down : label.style_label_up, size = size.tiny)
    if alMS
        alert(syminfo.ticker + " " + (cms > 0 ? "Bullish " : "Bearish ") + txt + " @ " + fmt(cmsLvl), alert.freq_once_per_bar)

//==============================================================================
// ALERT CONDITIONS
//==============================================================================
bool anyBull = cnb or cnbf or nBull1 or nBull2 or nBull3 or nBull4 or nBull5
bool anyBear = cns or cnsf or nBear1 or nBear2 or nBear3 or nBear4 or nBear5
alertcondition(anyBull, "New Bullish OB/FVG (any TF)", "{{ticker}} new Bullish Order Block / FVG")
alertcondition(anyBear, "New Bearish OB/FVG (any TF)", "{{ticker}} new Bearish Order Block / FVG")
alertcondition(buySig, "BUY signal", "{{ticker}} BUY @ {{close}}")
alertcondition(sellSig, "SELL signal", "{{ticker}} SELL @ {{close}}")
alertcondition(enterBull, "Price entered Bullish OB/FVG", "{{ticker}} price entered a Bullish OB/FVG zone @ {{close}}")
alertcondition(enterBear, "Price entered Bearish OB/FVG", "{{ticker}} price entered a Bearish OB/FVG zone @ {{close}}")
alertcondition(bslHit != "", "Buy-side liquidity swept", "{{ticker}} swept buy-side liquidity (highs) @ {{high}}")
alertcondition(sslHit != "", "Sell-side liquidity swept", "{{ticker}} swept sell-side liquidity (lows) @ {{low}}")
alertcondition(msShow and cms > 0, "Bullish BOS/CHoCH", "{{ticker}} Bullish structure break @ {{close}}")
alertcondition(msShow and cms < 0, "Bearish BOS/CHoCH", "{{ticker}} Bearish structure break @ {{close}}")

//==============================================================================
// DASHBOARD
//==============================================================================
btRow(table t, int row, string k, string v, color c) =>
    t.cell(0, row, k, text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    t.cell(1, row, v, text_color = c, text_size = size.small, text_halign = text.align_right)

if showBT and showSig and barstate.islast
    string pos = btPos == "Top Right" ? position.top_right : btPos == "Bottom Right" ? position.bottom_right :
         btPos == "Top Left" ? position.top_left : position.bottom_left
    var table bt = table.new(pos, 2, 11, bgcolor = color.new(chart.bg_color, 10), border_color = color.new(chart.fg_color, 80),
         border_width = 1, frame_color = color.new(chart.fg_color, 70), frame_width = 1)
    int   n    = btW + btL
    float wr   = n > 0 ? 100.0 * btW / n : na
    float be   = 100.0 / (1 + sigRR)
    float expR = n > 0 ? btR / n : na
    float pf   = btGL > 0 ? btGW / btGL : na
    color fg   = chart.fg_color
    color good = msBullCol
    color bad  = msBearCol
    bt.cell(0, 0, "Backtest BUY / SELL · R:R 1:" + str.tostring(sigRR) + " · spread " + str.tostring(btSpread), text_color = fg, text_size = size.small)
    bt.merge_cells(0, 0, 1, 0)
    btRow(bt, 1, "Trades (closed / open)", str.tostring(n) + " / " + str.tostring(sigTrades.size()), fg)
    btRow(bt, 2, "Win / Loss", str.tostring(btW) + " / " + str.tostring(btL), fg)
    btRow(bt, 3, "Win rate", na(wr) ? "-" : str.tostring(wr, "#.#") + "%", na(wr) ? fg : wr > be ? good : bad)
    btRow(bt, 4, "Break-even win rate", str.tostring(be, "#.#") + "% (before costs)", fg)
    btRow(bt, 5, "Expectancy / trade", na(expR) ? "-" : (expR >= 0 ? "+" : "") + str.tostring(expR, "#.##") + " R", na(expR) ? fg : expR > 0 ? good : bad)
    btRow(bt, 6, "Net result", (btR >= 0 ? "+" : "") + str.tostring(btR, "#.##") + " R", btR >= 0 ? good : bad)
    btRow(bt, 7, "Profit factor", na(pf) ? "-" : str.tostring(pf, "#.##"), na(pf) ? fg : pf >= 1 ? good : bad)
    btRow(bt, 8, "Max drawdown", "-" + str.tostring(btDD, "#.#") + " R", fg)
    btRow(bt, 9, "Avg SL distance", n > 0 ? fmt(btRisk / n) : "-", fg)
    btRow(bt, 10, "BUY · SELL (n · win)", (btBN > 0 ? str.tostring(btBN) + " · " + str.tostring(100.0 * btBW / btBN, "#") + "%" : "-") + "  |  " +
         (btSN > 0 ? str.tostring(btSN) + " · " + str.tostring(100.0 * btSW / btSN, "#") + "%" : "-"), fg)

trendCell(table tb, int row, string name, int tr) =>
    string txt = tr > 0 ? "▲ Bullish" : tr < 0 ? "▼ Bearish" : "– Neutral"
    color  c   = tr > 0 ? msBullCol : tr < 0 ? msBearCol : color.gray
    tb.cell(0, row, name, text_color = chart.fg_color, text_size = size.small)
    tb.cell(1, row, txt, text_color = color.white, bgcolor = color.new(c, 20), text_size = size.small)

if showDash and barstate.islast
    string p = dashPos == "Top Right" ? position.top_right : dashPos == "Bottom Right" ? position.bottom_right :
         dashPos == "Top Left" ? position.top_left : position.bottom_left
    var table tb = table.new(p, 2, 7, bgcolor = color.new(chart.bg_color, 10), border_color = color.new(chart.fg_color, 80),
         border_width = 1, frame_color = color.new(chart.fg_color, 70), frame_width = 1)
    tb.clear(0, 0, 1, 6)
    tb.cell(0, 0, "TF", text_color = chart.fg_color, text_size = size.small)
    tb.cell(1, 0, "Trend", text_color = chart.fg_color, text_size = size.small)
    int row = 1
    trendCell(tb, row, chartTag + " (chart)", cTrend)
    if v1
        row += 1
        trendCell(tb, row, tfName(eTf1), t1)
    if v2
        row += 1
        trendCell(tb, row, tfName(eTf2), t2)
    if v3
        row += 1
        trendCell(tb, row, tfName(eTf3), t3)
    if v4
        row += 1
        trendCell(tb, row, tfName(eTf4), t4)
    if v5
        row += 1
        trendCell(tb, row, tfName(eTf5), t5)
